<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══════════════════════════════════════════════════════════════════════
         AppWatch — Windows 11 Fluent Design System
         Ported from ZuiV2 DesignSystem.xaml (our own code)
         ══════════════════════════════════════════════════════════════════════ -->

    <!-- ── Semantic Colors ───────────────────────────────────────────────── -->
    <Color x:Key="SuccessColor">#2EA043</Color>
    <Color x:Key="ErrorColor">#D83B01</Color>
    <Color x:Key="WarningColor">#FFB900</Color>
    <Color x:Key="InfoColor">#0078D4</Color>

    <!-- ── Hero Colors ──────────────────────────────────────────────────── -->
    <Color x:Key="ZapretHeroColor">#1B3A5C</Color>
    <Color x:Key="ProxyHeroColor">#4A235A</Color>

    <!-- ── Accent Brushes ────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="RunningBrush"  Color="#2EA043"/>
    <SolidColorBrush x:Key="StoppedBrush"  Color="#616161"/>
    <SolidColorBrush x:Key="ErrorBrush"    Color="#D83B01"/>
    <SolidColorBrush x:Key="WarningBrush"  Color="#FFB900"/>
    <SolidColorBrush x:Key="InfoBrush"     Color="#0078D4"/>

    <!-- ── Card Style ────────────────────────────────────────────────────── -->
    <Style x:Key="CardBorder" TargetType="Button">
        <Setter Property="CornerRadius"   Value="8"/>
        <Setter Property="Background"
                Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush"
                Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="20,16"/>
        <Setter Property="Margin"          Value="0,0,0,2"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

    <Style x:Key="HeroCardBorder" TargetType="Border">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding"      Value="24,20"/>
        <Setter Property="Background"
                Value="{ThemeResource SystemControlHighlightAccentBrush}"/>
    </Style>

    <Style x:Key="ZapretHeroBorder" TargetType="Border">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding"      Value="24,20"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1A2F4A" Offset="0"/>
                    <GradientStop Color="#2D4A6F" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ProxyHeroBorder" TargetType="Border">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding"      Value="24,20"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#2D1B4E" Offset="0"/>
                    <GradientStop Color="#4A2D7A" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppWatchHeroBorder" TargetType="Border">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding"      Value="24,20"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#2D1B4E" Offset="0"/>
                    <GradientStop Color="#4A2D7A" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CatalogHeroBorder" TargetType="Border">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding"      Value="24,20"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1B3A5C" Offset="0"/>
                    <GradientStop Color="#2D5A8E" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WingetHeroBorder" TargetType="Border">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding"      Value="24,20"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1B3A2D" Offset="0"/>
                    <GradientStop Color="#2D5A3E" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Missing brushes used in new pages ──────────────────────────────── -->
    <SolidColorBrush x:Key="CardBorderBrush" Color="{ThemeResource CardStrokeColorDefaultBrush}"/>
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1A0078D4"/>

    <!-- ── Button Styles ─────────────────────────────────────────────────── -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding"      Value="14,7"/>
        <Setter Property="FontSize"     Value="13"/>
        <Setter Property="Background"
                Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
    </Style>

    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding"      Value="10,8"/>
        <Setter Property="MinWidth"     Value="40"/>
        <Setter Property="MinHeight"    Value="40"/>
        <Setter Property="Background"
                Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
    </Style>

    <Style x:Key="ToggleServiceButtonStyle" TargetType="Button">
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding"      Value="12,6"/>
        <Setter Property="MinHeight"    Value="32"/>
        <Setter Property="Background"
                Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush"
                Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- ── Typography ────────────────────────────────────────────────────── -->
    <Style x:Key="PageHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize"    Value="32"/>
        <Setter Property="FontWeight"  Value="SemiBold"/>
        <Setter Property="Margin"      Value="0,0,0,6"/>
    </Style>

    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize"      Value="14"/>
        <Setter Property="Foreground"
                Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Setter Property="Margin"        Value="0,0,0,20"/>
    </Style>

    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize"    Value="16"/>
        <Setter Property="FontWeight"  Value="SemiBold"/>
        <Setter Property="Margin"      Value="0,0,0,10"/>
    </Style>

    <Style x:Key="CardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize"      Value="14"/>
        <Setter Property="FontWeight"    Value="SemiBold"/>
        <Setter Property="Margin"        Value="0,0,0,4"/>
    </Style>

    <Style x:Key="CardSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize"      Value="12"/>
        <Setter Property="Foreground"
                Value="{ThemeResource TextFillColorSecondaryBrush}"/>
    </Style>

    <Style x:Key="CodeTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"  Value="Cascadia Code, Consolas"/>
        <Setter Property="FontSize"    Value="11"/>
        <Setter Property="Foreground"
                Value="{ThemeResource TextFillColorSecondaryBrush}"/>
    </Style>

    <!-- ── Tab Button Styles ─────────────────────────────────────────────── -->
    <Style x:Key="TabButtonStyle" TargetType="Button">
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding"      Value="12,6"/>
        <Setter Property="FontSize"     Value="12"/>
        <Setter Property="MinWidth"     Value="0"/>
        <Setter Property="Background"   Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style x:Key="TabButtonActiveStyle" TargetType="Button">
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding"      Value="12,6"/>
        <Setter Property="FontSize"     Value="12"/>
        <Setter Property="MinWidth"     Value="0"/>
        <Setter Property="Background"
                Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush"
                Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontWeight"   Value="SemiBold"/>
    </Style>

    <!-- ── Implicit Control Styles ───────────────────────────────────────── -->
    <Style TargetType="InfoBar">
        <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style TargetType="NavigationView">
        <Setter Property="OpenPaneLength" Value="240"/>
    </Style>

    <Style TargetType="NavigationViewItem">
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Margin" Value="0,1"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding"      Value="12,8"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style TargetType="ListView">
        <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="MinHeight"    Value="6"/>
    </Style>

    <Style TargetType="ToggleSwitch">
        <Setter Property="MinWidth" Value="0"/>
    </Style>

    <Style TargetType="ToggleButton">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="MinWidth"     Value="0"/>
    </Style>

    <Style TargetType="ProgressRing">
        <Setter Property="MinWidth"  Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
    </Style>

    <Style TargetType="Expander">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding"      Value="16"/>
    </Style>

    <Style TargetType="ContentDialog">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="DefaultButton" Value="Close"/>
    </Style>

    <Style TargetType="MenuFlyoutPresenter">
        <Setter Property="CornerRadius" Value="8"/>
    </Style>

</ResourceDictionary>
