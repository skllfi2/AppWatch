<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ════════════════════════════════════════════════════════════════════════
         AppWatch — Windows 11 Fluent Design System
         Ported from ZuiV2 DesignSystem.xaml (our own code)
         ════════════════════════════════════════════════════════════════════════ -->
    <!-- ── Semantic Colors ───────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="SuccessColor" Color="#2EA043"/>
    <SolidColorBrush x:Key="ErrorColor" Color="#D83B01"/>
    <SolidColorBrush x:Key="WarningColor" Color="#FFB900"/>
    <SolidColorBrush x:Key="InfoColor" Color="#0078D4"/>
    <!-- ── Accent Brushes ────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="RunningBrush"  Color="#2EA043"/>
    <SolidColorBrush x:Key="StoppedBrush"  Color="#616161"/>
    <SolidColorBrush x:Key="WarningBrush"  Color="#FFB900"/>
    <SolidColorBrush x:Key="InfoBrush"     Color="#0078D4"/>
    <!-- ── Card Styles ────────────────────────────────────────────────────── -->
    <Style x:Key="CardContainerStyle" TargetType="Border">
        <Setter Property="CornerRadius"    Value="8"/>
        <Setter Property="Background"      Value="{ThemeResource CardBackgroundFillColorDefault}"/>
        <Setter Property="BorderBrush"     Value="{ThemeResource CardStrokeColorDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="14,12"/>
        <Setter Property="Margin"          Value="0,0,0,4"/>
    </Style>
    <Style x:Key="CardBorder" TargetType="Button">
        <Setter Property="CornerRadius"   Value="8"/>
        <Setter Property="Background"
                Value="{ThemeResource CardBackgroundFillColorDefault}"/>
        <Setter Property="BorderBrush"
                Value="{ThemeResource CardStrokeColorDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="16,14"/>
        <Setter Property="Margin"          Value="0,0,0,4"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>
    <Style x:Key="HeroCardBorder" TargetType="Border">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding"      Value="20,16"/>
        <Setter Property="Background"
                Value="{ThemeResource SystemControlHighlightAccentBrush}"/>
    </Style>
    <!-- ── Empty States & Badges ─────────────────────────────────────────── -->
    <Style x:Key="EmptyStateCircleStyle" TargetType="Border">
        <Setter Property="Width"               Value="56"/>
        <Setter Property="Height"              Value="56"/>
        <Setter Property="CornerRadius"        Value="28"/>
        <Setter Property="Background"          Value="{StaticResource AccentSubtleBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment"   Value="Center"/>
    </Style>
    <Style x:Key="EmptyStateTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize"            Value="16"/>
        <Setter Property="FontWeight"          Value="SemiBold"/>
        <Setter Property="TextAlignment"       Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin"              Value="0,10,0,4"/>
    </Style>
    <Style x:Key="EmptyStateSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize"            Value="13"/>
        <Setter Property="Foreground"          Value="{ThemeResource TextFillColorSecondary}"/>
        <Setter Property="TextWrapping"        Value="Wrap"/>
        <Setter Property="TextAlignment"       Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="MaxWidth"            Value="400"/>
        <Setter Property="Margin"              Value="0,0,0,16"/>
    </Style>
    <Style x:Key="PillBadgeStyle" TargetType="Border">
        <Setter Property="CornerRadius"      Value="12"/>
        <Setter Property="Padding"           Value="8,3"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- ── Button Styles ─────────────────────────────────────────────────── -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding"      Value="14,7"/>
        <Setter Property="FontSize"     Value="13"/>
        <Setter Property="Background"
                Value="{ThemeResource CardBackgroundFillColorDefault}"/>
    </Style>
    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding"      Value="10,8"/>
        <Setter Property="MinWidth"     Value="40"/>
        <Setter Property="MinHeight"    Value="40"/>
        <Setter Property="Background"
                Value="{ThemeResource CardBackgroundFillColorDefault}"/>
    </Style>
    <Style x:Key="ToggleServiceButtonStyle" TargetType="Button">
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding"      Value="12,6"/>
        <Setter Property="MinHeight"    Value="32"/>
        <Setter Property="Background"
                Value="{ThemeResource CardBackgroundFillColorDefault}"/>
        <Setter Property="BorderBrush"
                Value="{ThemeResource CardStrokeColorDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <!-- ── Typography ────────────────────────────────────────────────────── -->
    <Style x:Key="PageHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize"    Value="28"/>
        <Setter Property="FontWeight"  Value="SemiBold"/>
        <Setter Property="Margin"      Value="0,0,0,4"/>
    </Style>
    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize"      Value="14"/>
        <Setter Property="Foreground"
                Value="{ThemeResource TextFillColorSecondary}"/>
        <Setter Property="Margin"        Value="0,0,0,16"/>
    </Style>
    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize"    Value="16"/>
        <Setter Property="FontWeight"  Value="SemiBold"/>
        <Setter Property="Margin"      Value="0,0,0,10"/>
    </Style>
    <Style x:Key="CardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize"      Value="14"/>
        <Setter Property="FontWeight"    Value="SemiBold"/>
        <Setter Property="Margin"        Value="0,0,0,4"/>
    </Style>
    <Style x:Key="CardSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize"      Value="12"/>
        <Setter Property="Foreground"
                Value="{ThemeResource TextFillColorSecondary}"/>
    </Style>
    <Style x:Key="CodeTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"  Value="Cascadia Code, Consolas"/>
        <Setter Property="FontSize"    Value="11"/>
        <Setter Property="Foreground"
                Value="{ThemeResource TextFillColorSecondary}"/>
    </Style>
    <!-- ── Tab Button Styles ─────────────────────────────────────────────── -->
    <Style x:Key="TabButtonStyle" TargetType="Button">
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding"      Value="12,6"/>
        <Setter Property="FontSize"     Value="12"/>
        <Setter Property="MinWidth"     Value="0"/>
        <Setter Property="Background"   Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="TabButtonActiveStyle" TargetType="Button">
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding"      Value="12,6"/>
        <Setter Property="FontSize"     Value="12"/>
        <Setter Property="MinWidth"     Value="0"/>
        <Setter Property="Background"
                Value="{ThemeResource CardBackgroundFillColorDefault}"/>
        <Setter Property="BorderBrush"
                Value="{ThemeResource CardStrokeColorDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontWeight"   Value="SemiBold"/>
    </Style>
    <!-- ── Implicit Control Styles ───────────────────────────────────────── -->
    <Style TargetType="InfoBar">
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style TargetType="NavigationView">
        <Setter Property="OpenPaneLength" Value="240"/>
    </Style>
    <Style TargetType="NavigationViewItem">
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Margin" Value="0,1"/>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding"      Value="10,6"/>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style TargetType="ListView">
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style TargetType="ProgressBar">
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="MinHeight"    Value="4"/>
    </Style>
    <Style TargetType="ToggleSwitch">
        <Setter Property="MinWidth" Value="0"/>
    </Style>
    <Style TargetType="ToggleButton">
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="MinWidth"     Value="0"/>
    </Style>
    <Style TargetType="ProgressRing">
        <Setter Property="MinWidth"  Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style TargetType="Expander">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding"      Value="16"/>
    </Style>
    <Style TargetType="ContentDialog">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="DefaultButton" Value="Close"/>
    </Style>
    <Style TargetType="MenuFlyoutPresenter">
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
</ResourceDictionary>
