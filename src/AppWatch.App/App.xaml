<Application
    x:Class="AppWatch.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Themes/Dark.xaml" />
                <ResourceDictionary Source="Styles/DesignSystem.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters (inline xmlns on each, ZuiV2 pattern) -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" xmlns:converters="using:AppWatch.Converters" />
            <converters:InverseBoolConverter x:Key="InverseBool" xmlns:converters="using:AppWatch.Converters" />
            <converters:StringToBoolConverter x:Key="StringToBool" xmlns:converters="using:AppWatch.Converters" />
            <converters:NotNullToVisibilityConverter x:Key="NotNullToVisibility" xmlns:converters="using:AppWatch.Converters" />
            <converters:CountToVisibilityConverter x:Key="CountToVisibility" xmlns:converters="using:AppWatch.Converters" />
            <converters:InverseCountToVisibilityConverter x:Key="InverseCountToVisibility" xmlns:converters="using:AppWatch.Converters" />
            <converters:StringToBrushConverter x:Key="StringToBrushConverter" xmlns:converters="using:AppWatch.Converters" />

            <!-- Mica: transparent backgrounds -->
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewEnabledBackground" Color="Transparent" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="Transparent" />
            <SolidColorBrush x:Key="LayerFillColorSecondaryBrush" Color="Transparent" />
            <SolidColorBrush x:Key="LayerFillColorTertiaryBrush" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="Transparent" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
