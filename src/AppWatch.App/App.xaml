<Application
    x:Class="AppWatch.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:AppWatch.Converters">
    <Application.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                    <ResourceDictionary Source="Themes/Dark.xaml" />
                    <ResourceDictionary Source="Styles/DesignSystem.xaml" />
                </ResourceDictionary.MergedDictionaries>

                <!-- Converters -->
                <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
                <conv:InverseBoolConverter x:Key="InverseBool"/>
                <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
                <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibility"/>
                <conv:StringEmptyToVisibilityConverter x:Key="StringEmptyToVisibility"/>
                <conv:InverseCountToVisibilityConverter x:Key="InverseCountToVisibility"/>
                <conv:CountToVisibilityConverter x:Key="CountToVisibility"/>
                <conv:ObjectToVisibilityConverter x:Key="ObjectToVisibility"/>
                <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
                <conv:StringToBrushConverter x:Key="StringToBrush"/>
                <conv:FirstCharToBrushConverter x:Key="FirstCharToBrush"/>
                <conv:StringToImageSourceConverter x:Key="StringToImageSource"/>
                <conv:StageToBrushConverter x:Key="StageToBrush"/>
                <conv:StageToVisConverter x:Key="StageToVis"/>

                <!-- Mica: transparent backgrounds -->
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewEnabledBackground" Color="Transparent" />
                <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="Transparent" />
                <SolidColorBrush x:Key="LayerFillColorSecondaryBrush" Color="Transparent" />
                <SolidColorBrush x:Key="LayerFillColorTertiaryBrush" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="Transparent" />
            </ResourceDictionary>
        </Application.Resources>
    </Application>
