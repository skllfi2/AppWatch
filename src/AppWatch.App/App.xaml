<Application
    x:Class="AppWatch.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:AppWatch.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Themes/ThemeResources.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/DesignSystem.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <conv:InverseBoolConverter x:Key="InverseBool"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
            <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibility"/>
            <conv:StringEmptyToVisibilityConverter x:Key="StringEmptyToVisibility"/>
            <conv:InverseCountToVisibilityConverter x:Key="InverseCountToVisibility"/>
            <conv:CountToVisibilityConverter x:Key="CountToVisibility"/>
            <conv:ObjectToVisibilityConverter x:Key="ObjectToVisibility"/>
            <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
            <conv:StringToBoolConverter x:Key="StringToBool"/>
            <conv:NotNullToVisibilityConverter x:Key="NotNullToVisibility"/>

            <!-- Brushes & Stage converters with both short and suffix keys -->
            <conv:StringToBrushConverter x:Key="StringToBrush"/>
            <conv:StringToBrushConverter x:Key="StringToBrushConverter"/>
            <conv:FirstCharToBrushConverter x:Key="FirstCharToBrush"/>
            <conv:FirstCharToBrushConverter x:Key="FirstCharToBrushConverter"/>
            <conv:StringToImageSourceConverter x:Key="StringToImageSource"/>
            <conv:StringToImageSourceConverter x:Key="StringToImageSourceConverter"/>
            <conv:StageToBrushConverter x:Key="StageToBrush"/>
            <conv:StageToBrushConverter x:Key="StageToBrushConverter"/>
            <conv:StageToVisConverter x:Key="StageToVis"/>
            <conv:StageToVisConverter x:Key="StageToVisConverter"/>

            <!-- Mica: transparent backgrounds -->
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewEnabledBackground" Color="Transparent" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="Transparent" />
            <SolidColorBrush x:Key="LayerFillColorSecondaryBrush" Color="Transparent" />
            <SolidColorBrush x:Key="LayerFillColorTertiaryBrush" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="Transparent" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
