<Window
    x:Class="AppWatch.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AppWatch">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid Background="Transparent" AllowDrop="True" DragOver="Grid_DragOver" Drop="Grid_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TitleBar Grid.Row="0" x:Name="AppTitleBar" Title="AppWatch" />
        <!-- ZuiV2 shell v2: persistent left navigation pane instead of hub-page
             nav cards. Mica shows through the transparent pane. -->
        <NavigationView Grid.Row="1"
                        x:Name="Nav"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        OpenPaneLength="228"
                        Background="Transparent"
                        SelectionChanged="Nav_SelectionChanged">
            <NavigationView.Resources>
                            <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent"/>
                            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent"/>
                        </NavigationView.Resources>
            <NavigationView.MenuItems>
                            <NavigationViewItem x:Name="NavItemTrackedApps" Tag="trackedapps" Content="{x:Bind Loc.TrackedApps, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71D;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                            <NavigationViewItem x:Name="NavItemUpdates" Tag="updates" Content="{x:Bind Loc.TabUpdates, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                            <NavigationViewItem Tag="winget" Content="{x:Bind Loc.WingetUpdates, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B8;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                            <NavigationViewItem Tag="history" Content="{x:Bind Loc.NavHistory, Mode=OneWay}">
                                <NavigationViewItem.Icon>
                                    <FontIcon Glyph="&#xE81C;"/>
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                        </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Tag="settings" Content="{x:Bind Loc.NavSettings, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="about" Content="{x:Bind Loc.NavAbout, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Grid>
                <Frame x:Name="ContentFrame" Background="Transparent" />
                <ProgressBar x:Name="HeaderProgressBar"
                             VerticalAlignment="Top"
                             Height="3"
                             IsIndeterminate="True"
                             Visibility="Collapsed" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
