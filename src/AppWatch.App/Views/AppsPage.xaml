<Page
    x:Class="AppWatch.Views.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AppWatch.ViewModels"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <conv:StageToVisConverter x:Key="StageToVis" xmlns:conv="using:AppWatch.Converters" />
        <conv:FirstCharToBrushConverter x:Key="FirstCharToBrush" xmlns:conv="using:AppWatch.Converters" />
    </Page.Resources>

    <Grid Padding="32,24" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16">

                <Border Style="{StaticResource AppWatchHeroBorder}">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto">
                        <StackPanel Grid.Column="0" Grid.Row="0" Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE895;" FontSize="28" Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind Loc.HeroTitle, Mode=OneWay}" FontSize="28" FontWeight="SemiBold"
                                           Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Background="#80000000" CornerRadius="10" Padding="16,12" MinWidth="120">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{x:Bind Loc.HeroMetricTracked, Mode=OneWay}" FontSize="11" Foreground="{StaticResource HeroSecondaryBrush}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Ellipse Width="10" Height="10" Fill="{x:Bind ViewModel.StatusDotBrush, Mode=OneWay}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{x:Bind ViewModel.AppsTrackedCount, Mode=OneWay}"
                                                       FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Background="#80000000" CornerRadius="10" Padding="16,12" MinWidth="100">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{x:Bind Loc.HeroMetricUpdates, Mode=OneWay}" FontSize="11" Foreground="{StaticResource HeroSecondaryBrush}"/>
                                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="White">
                                            <Run Text="&#x2B06;"/><Run Text="{x:Bind ViewModel.UpdatesAvailableCount, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Background="#80000000" CornerRadius="10" Padding="16,12" MinWidth="90">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{x:Bind Loc.HeroMetricUpdatedToday, Mode=OneWay}" FontSize="11" Foreground="{StaticResource HeroSecondaryBrush}"/>
                                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="White">
                                            <Run Text="&#x2705;"/><Run Text="{x:Bind ViewModel.UpdatedTodayCount, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <Button Command="{x:Bind ViewModel.CheckUpdatesCommand}"
                                                            ToolTipService.ToolTip="{x:Bind Loc.QuickCheck, Mode=OneWay}"
                                                            Padding="12,6" CornerRadius="6"
                                                            Background="{StaticResource HeroOverlayBrush}" BorderThickness="0">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon Glyph="&#xE895;" FontSize="12" Foreground="{StaticResource HeroTertiaryBrush}"/>
                                                            <TextBlock Text="{x:Bind Loc.QuickCheck, Mode=OneWay}" FontSize="11" Foreground="{StaticResource HeroTertiaryBrush}"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Command="{x:Bind ViewModel.UpdateAllCommand}"
                                                            ToolTipService.ToolTip="{x:Bind Loc.UpdateAll, Mode=OneWay}"
                                                            Padding="12,6" CornerRadius="6"
                                                            Background="{StaticResource HeroOverlayBrush}" BorderThickness="0"
                                                            Visibility="{x:Bind ViewModel.IsUpdateAllRunning, Converter={StaticResource InverseBoolToVisibility}, Mode=OneWay}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon Glyph="&#xE896;" FontSize="12" Foreground="{StaticResource HeroTertiaryBrush}"/>
                                                            <TextBlock Text="{x:Bind Loc.UpdateAll, Mode=OneWay}" FontSize="11" Foreground="{StaticResource HeroTertiaryBrush}"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Command="{x:Bind ViewModel.StopUpdateAllCommand}"
                                                            ToolTipService.ToolTip="{x:Bind Loc.BtnStop, Mode=OneWay}"
                                                            Padding="12,6" CornerRadius="6"
                                                            Background="#80D83B01" BorderThickness="0"
                                                            Visibility="{x:Bind ViewModel.IsUpdateAllRunning, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="White"/>
                                                            <TextBlock Text="{x:Bind Loc.BtnStop, Mode=OneWay}" FontSize="11" Foreground="White"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Command="{x:Bind ViewModel.AddCustomAppCommand}"
                                                            AutomationProperties.Name="{x:Bind Loc.AddApp, Mode=OneWay}"
                                                            ToolTipService.ToolTip="{x:Bind Loc.AddApp, Mode=OneWay}"
                                                            Padding="12,6" CornerRadius="6"
                                                            Background="{StaticResource HeroOverlayBrush}" BorderThickness="0">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon Glyph="&#xE710;" FontSize="12" Foreground="{StaticResource HeroTertiaryBrush}"/>
                                                            <TextBlock Text="{x:Bind Loc.AddApp, Mode=OneWay}" FontSize="11" Foreground="{StaticResource HeroTertiaryBrush}"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0">
                        <FontIcon Glyph="&#xE896;" FontSize="14" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="{x:Bind Loc.TrackedApps, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" CharacterSpacing="40"/>
                    </StackPanel>

                    <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="8" Padding="24"
                            Visibility="{x:Bind ViewModel.Apps.Count, Converter={StaticResource InverseCountToVisibility}, Mode=OneWay}">
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE8F1;" FontSize="24" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{x:Bind Loc.NoTrackedApps, Mode=OneWay}" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <ListView ItemsSource="{x:Bind ViewModel.Apps}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:TrackedAppItem">
                                <Grid Padding="16" ColumnSpacing="16" Margin="0,0,0,8"
                                      Background="{StaticResource CardBackgroundBrush}"
                                      CornerRadius="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="6"
                                            Background="{x:Bind MonogramBrush}" VerticalAlignment="Center"
                                            Margin="0,0,12,0">
                                        <TextBlock Text="{x:Bind Monogram}" FontSize="16" FontWeight="SemiBold"
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Ellipse Width="10" Height="10" Fill="{x:Bind StatusBrush, Mode=OneWay}" VerticalAlignment="Center"
                                                     ToolTipService.ToolTip="{x:Bind StatusTooltip, Mode=OneWay}"/>
                                            <TextBlock Text="{x:Bind Version, Mode=OneWay}" Opacity="0.7" FontSize="12"/>
                                            <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Opacity="0.7" FontSize="12"/>
                                            <!-- A1: pin/skip rule badge -->
                                            <Border CornerRadius="4" Padding="6,1" Background="#33FFFFFF"
                                                    Visibility="{x:Bind RuleBadge, Converter={StaticResource StringNotEmptyToVisibility}, Mode=OneWay}">
                                                <TextBlock Text="{x:Bind RuleBadge, Mode=OneWay}" FontSize="10" Opacity="0.75"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <ProgressBar Grid.Column="2" VerticalAlignment="Center" Width="120" Height="6"
                                                 Minimum="0" Maximum="100"
                                                 Value="{x:Bind ProgressValue, Mode=OneWay}"
                                                 Visibility="{x:Bind Stage, Converter={StaticResource StageToVis}, Mode=OneWay}"
                                                 IsIndeterminate="False"/>

                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                            <Button Command="{x:Bind UpdateOneCommand}" CommandParameter="{x:Bind}"
                                                                                    AutomationProperties.Name="{x:Bind BtnUpdateOne, Mode=OneWay}"
                                                                                    Visibility="{x:Bind UpdateAvailable, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                                                                                    Padding="12,6" CornerRadius="6"
                                                                                    Background="{StaticResource HeroOverlayBrush}" BorderThickness="0">
                                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                    <FontIcon Glyph="&#xE896;" FontSize="12" Foreground="{StaticResource HeroTertiaryBrush}"/>
                                                                                    <TextBlock Text="{x:Bind BtnUpdateOne}" FontSize="11" Foreground="{StaticResource HeroTertiaryBrush}"/>
                                                                                </StackPanel>
                                                                            </Button>
                                                                            <Button Command="{x:Bind LaunchAppCommand}" CommandParameter="{x:Bind}"
                                                                                    AutomationProperties.Name="{x:Bind BtnLaunch, Mode=OneWay}"
                                                                                    Visibility="{x:Bind HasLaunchInfo, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                                                                                    Padding="12,6" CornerRadius="6"
                                                                                    Background="{StaticResource HeroOverlayBrush}" BorderThickness="0">
                                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                    <FontIcon Glyph="&#xE768;" FontSize="12" Foreground="{StaticResource HeroTertiaryBrush}"/>
                                                                                    <TextBlock Text="{x:Bind BtnLaunch}" FontSize="11" Foreground="{StaticResource HeroTertiaryBrush}"/>
                                                                                </StackPanel>
                                                                            </Button>
                                                                            <Button Command="{x:Bind EditAppCommand}" CommandParameter="{x:Bind}"
                                                                                                                            AutomationProperties.Name="{x:Bind BtnEdit, Mode=OneWay}"
                                                                                                                            Padding="12,6" CornerRadius="6"
                                                                                                                            Background="{StaticResource HeroOverlayBrush}" BorderThickness="0"
                                                                                                                            ToolTipService.ToolTip="{x:Bind BtnEdit}">
                                                                                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                                                            <FontIcon Glyph="&#xE70F;" FontSize="12" Foreground="{StaticResource HeroTertiaryBrush}"/>
                                                                                                                            <TextBlock Text="{x:Bind BtnEdit}" FontSize="11" Foreground="{StaticResource HeroTertiaryBrush}"/>
                                                                                                                        </StackPanel>
                                                                                                                    </Button>
                                                                            <Button Command="{x:Bind RollbackAppCommand}" CommandParameter="{x:Bind}"
                                                                                    AutomationProperties.Name="{x:Bind BtnRollback, Mode=OneWay}"
                                                                                    Visibility="{x:Bind RollbackAvailable, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                                                                                    Padding="12,6" CornerRadius="6"
                                                                                    Background="{StaticResource HeroOverlayBrush}" BorderThickness="0"
                                                                                    ToolTipService.ToolTip="{x:Bind BtnRollback}">
                                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                    <FontIcon Glyph="&#xE7A6;" FontSize="12" Foreground="{StaticResource HeroTertiaryBrush}"/>
                                                                                    <TextBlock Text="{x:Bind BtnRollback}" FontSize="11" Foreground="{StaticResource HeroTertiaryBrush}"/>
                                                                                </StackPanel>
                                                                            </Button>
                                                                            <!-- A1: per-app update rules menu -->
                                                                            <Button Padding="8,6" CornerRadius="6"
                                                                                    AutomationProperties.Name="{x:Bind MenuUpdateRules, Mode=OneWay}"
                                                                                    Background="{StaticResource HeroOverlayBrush}" BorderThickness="0"
                                                                                    ToolTipService.ToolTip="{x:Bind MenuUpdateRules, Mode=OneWay}">
                                                                                <FontIcon Glyph="&#xE10C;" FontSize="12" Foreground="{StaticResource HeroTertiaryBrush}"/>
                                                                                <Button.Flyout>
                                                                                    <MenuFlyout>
                                                                                        <MenuFlyoutItem Command="{x:Bind SkipVersionCommand}" CommandParameter="{x:Bind}"
                                                                                                        Text="{x:Bind MenuSkipVersion, Mode=OneWay}"
                                                                                                        Visibility="{x:Bind UpdateAvailable, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                                                                            <MenuFlyoutItem.Icon>
                                                                                                <FontIcon Glyph="&#xE7E3;"/>
                                                                                            </MenuFlyoutItem.Icon>
                                                                                        </MenuFlyoutItem>
                                                                                        <MenuFlyoutItem Command="{x:Bind PinCurrentCommand}" CommandParameter="{x:Bind}"
                                                                                                        Text="{x:Bind MenuPinCurrent, Mode=OneWay}">
                                                                                            <MenuFlyoutItem.Icon>
                                                                                                <FontIcon Glyph="&#xE840;"/>
                                                                                            </MenuFlyoutItem.Icon>
                                                                                        </MenuFlyoutItem>
                                                                                        <MenuFlyoutSeparator/>
                                                                                        <MenuFlyoutItem Command="{x:Bind ResetRulesCommand}" CommandParameter="{x:Bind}"
                                                                                                        Text="{x:Bind MenuResetRules, Mode=OneWay}"
                                                                                                        Visibility="{x:Bind RuleBadge, Converter={StaticResource StringNotEmptyToVisibility}, Mode=OneWay}">
                                                                                            <MenuFlyoutItem.Icon>
                                                                                                <FontIcon Glyph="&#xE74D;"/>
                                                                                            </MenuFlyoutItem.Icon>
                                                                                        </MenuFlyoutItem>
                                                                                    </MenuFlyout>
                                                                                </Button.Flyout>
                                                                            </Button>
                                                                        </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0" HorizontalAlignment="Center">
                    <Button Click="NavCard_Click" Tag="catalog"
                            AutomationProperties.Name="{x:Bind Loc.Catalog, Mode=OneWay}"
                            Padding="14,10" CornerRadius="10"
                            Background="{StaticResource CardBackgroundBrush}" BorderThickness="1"
                            BorderBrush="{StaticResource BorderDefaultBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8F1;" FontSize="16" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="{x:Bind Loc.Catalog, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Button>
                    <Button Click="NavCard_Click" Tag="winget"
                                                AutomationProperties.Name="{x:Bind Loc.WingetUpdates, Mode=OneWay}"
                                                Padding="14,10" CornerRadius="10"
                                                Background="{StaticResource CardBackgroundBrush}" BorderThickness="1"
                                                BorderBrush="{StaticResource BorderDefaultBrush}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE753;" FontSize="16" Foreground="{StaticResource AccentBrush}"/>
                                                <TextBlock Text="{x:Bind Loc.WingetUpdates, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Click="NavCard_Click" Tag="history"
                                                AutomationProperties.Name="{x:Bind Loc.NavHistory, Mode=OneWay}"
                                                Padding="14,10" CornerRadius="10"
                                                Background="{StaticResource CardBackgroundBrush}" BorderThickness="1"
                                                BorderBrush="{StaticResource BorderDefaultBrush}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE81C;" FontSize="16" Foreground="{StaticResource AccentBrush}"/>
                                                <TextBlock Text="{x:Bind Loc.NavHistory, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Click="NavCard_Click" Tag="settings"
                            AutomationProperties.Name="{x:Bind Loc.NavSettings, Mode=OneWay}"
                            Padding="14,10" CornerRadius="10"
                            Background="{StaticResource CardBackgroundBrush}" BorderThickness="1"
                            BorderBrush="{StaticResource BorderDefaultBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE713;" FontSize="16" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="{x:Bind Loc.NavSettings, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Button>
                    <Button Click="NavCard_Click" Tag="about"
                            AutomationProperties.Name="{x:Bind Loc.NavAbout, Mode=OneWay}"
                            Padding="14,10" CornerRadius="10"
                            Background="{StaticResource CardBackgroundBrush}" BorderThickness="1"
                            BorderBrush="{StaticResource BorderDefaultBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="{x:Bind Loc.NavAbout, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{StaticResource CardBackgroundBrush}" CornerRadius="8" Padding="16,8" Margin="0,12,0,0">
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</Page>