<Page
    x:Class="AppWatch.Views.CatalogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AppWatch.ViewModels"
    xmlns:models="using:AppWatch.Core.Domain.Models"
    Background="Transparent"
    NavigationCacheMode="Required">

    <Grid Padding="32,24" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header with back button (ZuiV2 pattern) -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
            <Button Click="Back_Click" Padding="8" CornerRadius="6" Background="Transparent" BorderThickness="0">
                <FontIcon Glyph="&#xE72B;" FontSize="14"/>
            </Button>
            <StackPanel Spacing="4">
                <TextBlock Text="{x:Bind Loc.Catalog, Mode=OneWay}" Style="{StaticResource PageHeaderStyle}" />
                <TextBlock Text="{x:Bind Loc.CatalogHint, Mode=OneWay}" Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="16">

                        <!-- Catalog List (ZuiV2 card rows) -->
                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0">
                                        <FontIcon Glyph="&#xE8F1;" FontSize="14" Foreground="{StaticResource AccentBrush}"/>
                                        <TextBlock Text="{x:Bind Loc.Catalog, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}" CharacterSpacing="40"/>
                                    </StackPanel>

                                    <!-- Search + Add row -->
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{x:Bind ViewModel.CatalogSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="{x:Bind Loc.CatalogSearchPlaceholder, Mode=OneWay}"
                                                 Background="{StaticResource CardBackgroundBrush}" CornerRadius="6"
                                                 BorderThickness="1" Padding="8,6" FontSize="13"/>
                                        <Button Grid.Column="1" Command="{x:Bind ViewModel.AddToCatalogCommand}"
                                                Content="{x:Bind Loc.AddApp, Mode=OneWay}"
                                                Padding="12,6" CornerRadius="6" FontSize="12"
                                                Background="{StaticResource CardBackgroundBrush}" BorderThickness="1"/>
                                    </Grid>

                                    <!-- Sources section: subscribe to external catalogs -->
                                    <StackPanel Spacing="8" Margin="0,4,0,8">
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0">
                                            <FontIcon Glyph="&#xE8F1;" FontSize="14" Foreground="{StaticResource AccentBrush}"/>
                                            <TextBlock Text="{x:Bind Loc.SourcesSection, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}" CharacterSpacing="40"/>
                                        </StackPanel>

                                        <!-- Source list -->
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.CatalogSources, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:CatalogSource">
                                                    <Grid Padding="8,4" ColumnSpacing="8" Margin="0,0,0,4"
                                                          Background="{StaticResource CardBackgroundBrush}"
                                                          CornerRadius="6" BorderThickness="1"
                                                          BorderBrush="{StaticResource BorderDefaultBrush}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ToggleSwitch Grid.Column="0" IsOn="{x:Bind Enabled, Mode=TwoWay}"
                                                                      MinWidth="0" Margin="0,0,4,0"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind Name}" FontSize="12" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{x:Bind Url}" FontSize="10" Opacity="0.6" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Add source row -->
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{x:Bind ViewModel.NewSourceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     PlaceholderText="{x:Bind Loc.SourceNamePlaceholder, Mode=OneWay}"
                                                     Width="160" CornerRadius="6" BorderThickness="1"
                                                     Background="{StaticResource CardBackgroundBrush}" FontSize="12"/>
                                            <TextBox Grid.Column="1" Text="{x:Bind ViewModel.NewSourceUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     PlaceholderText="{x:Bind Loc.SourceUrlPlaceholder, Mode=OneWay}"
                                                     CornerRadius="6" BorderThickness="1"
                                                     Background="{StaticResource CardBackgroundBrush}" FontSize="12"/>
                                            <Button Grid.Column="2" Command="{x:Bind ViewModel.AddCatalogSourceCommand}"
                                                    Content="{x:Bind Loc.BtnAddSource, Mode=OneWay}"
                                                    Padding="12,6" CornerRadius="6" FontSize="12"
                                                    Background="{StaticResource CardBackgroundBrush}" BorderThickness="1"/>
                                        </Grid>
                                    </StackPanel>

                                    <ListView ItemsSource="{x:Bind ViewModel.FilteredCatalogApps, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:CatalogItem">
                                <Grid Padding="16" ColumnSpacing="16" Margin="0,0,0,8"
                                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                      BorderThickness="1" CornerRadius="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Monogram -->
                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="6"
                                            Background="{x:Bind MonogramBrush}" VerticalAlignment="Center"
                                            Margin="0,0,12,0">
                                        <TextBlock Text="{x:Bind Monogram}" FontSize="16" FontWeight="SemiBold"
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Name + description + install status -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14" />
                                            <Border CornerRadius="4" Padding="5,1" Background="#33FFFFFF"
                                                    Visibility="{x:Bind IsUserEntry, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                                <TextBlock Text="{x:Bind UserEntryBadge, Mode=OneWay}" FontSize="9" Opacity="0.6" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Description}" Opacity="0.7" FontSize="12"
                                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind InstallStatus, Mode=OneWay}" Opacity="0.6" FontSize="12" />
                                    </StackPanel>

                                    <!-- Buttons column -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Style="{StaticResource AccentButtonStyle}"
                                                Command="{x:Bind InstallFromCatalogCommand}"
                                                CommandParameter="{x:Bind}"
                                                Content="{x:Bind InstallButtonText}"
                                                VerticalAlignment="Center"
                                                Padding="16,8" FontSize="13" />
                                        <Button Command="{x:Bind RemoveFromCatalogCommand}"
                                                CommandParameter="{x:Bind}"
                                                VerticalAlignment="Center"
                                                Padding="8,8" CornerRadius="6"
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                Visibility="{x:Bind IsUserEntry, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                                                ToolTipService.ToolTip="{x:Bind BtnRemoveFromCatalog, Mode=OneWay}"
                                                AutomationProperties.Name="{x:Bind BtnRemoveFromCatalog, Mode=OneWay}">
                                            <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Empty state -->
                                        <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="8" Padding="24"
                                                                    Visibility="{x:Bind ViewModel.CatalogApps.Count, Converter={StaticResource InverseCountToVisibility}, Mode=OneWay}">
                                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE8F1;" FontSize="24" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{x:Bind Loc.CatalogEmpty, Mode=OneWay}" FontSize="12"
                                                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                                           HorizontalAlignment="Center" TextAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                </StackPanel>

                <!-- Status bar -->
                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Opacity="0.7" />

            </StackPanel>

            		</ScrollViewer>
            	</Grid>
            </Page>
