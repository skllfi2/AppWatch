<Page
    x:Class="AppWatch.Views.CatalogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AppWatch.ViewModels"
    Background="Transparent"
    NavigationCacheMode="Required">

    <Grid Padding="32,24" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header with back button (ZuiV2 pattern) -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
            <Button Click="Back_Click" Padding="8" CornerRadius="6" Background="Transparent" BorderThickness="0">
                <FontIcon Glyph="&#xE72B;" FontSize="14"/>
            </Button>
            <StackPanel Spacing="4">
                <TextBlock Text="{x:Bind Loc.Catalog, Mode=OneWay}" Style="{StaticResource PageHeaderStyle}" />
                <TextBlock Text="{x:Bind Loc.CatalogHint, Mode=OneWay}" Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16">

                <!-- Catalog Hero Banner (ZuiV2 ProxyHeroBorder pattern) -->
                                <Border Style="{StaticResource CatalogHeroBorder}">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto">
                        <!-- Left: Title + Metrics -->
                        <StackPanel Grid.Column="0" Grid.Row="0" Spacing="12">
                            <!-- Title row -->
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE8F1;" FontSize="28" Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind Loc.Catalog, Mode=OneWay}" FontSize="28" FontWeight="SemiBold"
                                           Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Metrics row -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Background="{StaticResource HeroOverlayBrush}" CornerRadius="10" Padding="16,12" MinWidth="120">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{x:Bind Loc.CatalogMetricTotal, Mode=OneWay}" FontSize="11" Foreground="{StaticResource HeroSecondaryBrush}"/>
                                        <TextBlock Text="{x:Bind ViewModel.CatalogTotalCount, Mode=OneWay}"
                                                   FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource HeroOverlayBrush}" CornerRadius="10" Padding="16,12" MinWidth="100">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{x:Bind Loc.CatalogMetricTracked, Mode=OneWay}" FontSize="11" Foreground="{StaticResource HeroSecondaryBrush}"/>
                                        <TextBlock Text="{x:Bind ViewModel.CatalogTrackedCount, Mode=OneWay}"
                                                   FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource HeroOverlayBrush}" CornerRadius="10" Padding="16,12" MinWidth="90">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{x:Bind Loc.CatalogMetricUpdates, Mode=OneWay}" FontSize="11" Foreground="{StaticResource HeroSecondaryBrush}"/>
                                        <TextBlock Text="{x:Bind ViewModel.CatalogUpdatesAvailable, Mode=OneWay}"
                                                   FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Right: Quick action -->
                        <StackPanel Grid.Column="1" Grid.Row="0" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Command="{x:Bind ViewModel.AddCustomAppCommand}"
                                    ToolTipService.ToolTip="{x:Bind Loc.CatalogAddCustom, Mode=OneWay}"
                                    Padding="12,6" CornerRadius="6"
                                    Background="{StaticResource HeroOverlayBrush}" BorderThickness="0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" FontSize="14" Foreground="{StaticResource HeroTertiaryBrush}"/>
                                    <TextBlock Text="{x:Bind Loc.CatalogAddCustom, Mode=OneWay}"
                                               FontSize="13" Foreground="{StaticResource HeroTertiaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Catalog List (ZuiV2 card rows) -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0">
                        <FontIcon Glyph="&#xE8F1;" FontSize="14" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="{x:Bind Loc.Catalog, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" CharacterSpacing="40"/>
                    </StackPanel>

                    <ListView ItemsSource="{x:Bind ViewModel.CatalogApps}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:CatalogItem">
                                <Grid Padding="16" ColumnSpacing="16" Margin="0,0,0,8"
                                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                      BorderThickness="1" CornerRadius="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Monogram -->
                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="6"
                                            Background="{x:Bind MonogramBrush}" VerticalAlignment="Center"
                                            Margin="0,0,12,0">
                                        <TextBlock Text="{x:Bind Monogram}" FontSize="16" FontWeight="SemiBold"
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Name + description + install status -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock Text="{x:Bind Description}" Opacity="0.7" FontSize="12"
                                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind InstallStatus, Mode=OneWay}" Opacity="0.6" FontSize="12" />
                                    </StackPanel>

                                    <!-- Install button -->
                                    <Button Grid.Column="2"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Command="{x:Bind InstallFromCatalogCommand}"
                                            CommandParameter="{x:Bind}"
                                            Content="{x:Bind InstallButtonText}"
                                            VerticalAlignment="Center"
                                            Padding="16,8" FontSize="13" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Empty state -->
                    <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="8" Padding="24"
                          Visibility="{x:Bind ViewModel.CatalogApps.Count, Converter={StaticResource InverseCountToVisibility}, Mode=OneWay}">
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE8F1;" FontSize="24" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{x:Bind Loc.NoTrackedApps, Mode=OneWay}" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- Status bar -->
                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Opacity="0.7" />

            </StackPanel>

            		</ScrollViewer>
            	</Grid>
            </Page>
