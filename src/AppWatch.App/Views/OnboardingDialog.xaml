<ContentDialog
    x:Class="AppWatch.Views.OnboardingDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="{x:Bind Loc.OnboardingTitle, Mode=OneWay}"
    PrimaryButtonText="{x:Bind Loc.OnboardingBtnStart, Mode=OneWay}"
    CloseButtonText=""
    DefaultButton="Primary"
    Background="{StaticResource CardBackgroundBrush}"
    CornerRadius="12">

    <StackPanel Spacing="16" MaxWidth="480" HorizontalAlignment="Center">
        <!-- App icon / logo -->
        <Border Width="80" Height="80" CornerRadius="16"
                Background="{StaticResource AccentBrush}"
                HorizontalAlignment="Center" Margin="0,8,0,0">
            <TextBlock Text="AW" FontSize="32" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- Welcome text -->
        <TextBlock Text="{x:Bind Loc.OnboardingWelcome, Mode=OneWay}"
                   FontSize="20" FontWeight="SemiBold"
                   TextAlignment="Center"
                   Foreground="{StaticResource TextPrimaryBrush}"/>

        <TextBlock Text="{x:Bind Loc.OnboardingDescription, Mode=OneWay}"
                   FontSize="13" Opacity="0.8"
                   TextWrapping="Wrap" TextAlignment="Center"
                   Foreground="{StaticResource TextSecondaryBrush}"/>

        <!-- Feature highlights -->
        <StackPanel Spacing="10" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE74A;" FontSize="16" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="{x:Bind Loc.OnboardingFeature1, Mode=OneWay}"
                           FontSize="13" VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE710;" FontSize="16" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="{x:Bind Loc.OnboardingFeature2, Mode=OneWay}"
                           FontSize="13" VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE753;" FontSize="16" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="{x:Bind Loc.OnboardingFeature3, Mode=OneWay}"
                           FontSize="13" VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE81C;" FontSize="16" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="{x:Bind Loc.OnboardingFeature4, Mode=OneWay}"
                           FontSize="13" VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>
        </StackPanel>

        <!-- Version info -->
        <TextBlock Text="{x:Bind Loc.OnboardingVersion, Mode=OneWay}"
                   FontSize="11" Opacity="0.5"
                   TextAlignment="Center"
                   Foreground="{StaticResource TextTertiaryBrush}"
                   Margin="0,8,0,0"/>
    </StackPanel>
</ContentDialog>