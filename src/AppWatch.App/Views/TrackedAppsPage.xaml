<Page
    x:Class="AppWatch.Views.TrackedAppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:AppWatch.ViewModels"
    mc:Ignorable="d"
    Background="Transparent"
    x:Name="PageRoot">

    <Page.Resources>
        <DataTemplate x:Key="TrackedAppItemTemplate" x:DataType="vm:TrackedAppItem">
            <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="8" Padding="12"
                    BorderThickness="1" BorderBrush="{StaticResource BorderDefaultBrush}"
                    Margin="0,4">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App icon/avatar -->
                    <Grid Grid.Column="0" Width="40" Height="40" CornerRadius="6" VerticalAlignment="Center">
                        <Image Source="{x:Bind Icon, Mode=OneWay}"
                               Stretch="UniformToFill"
                               Visibility="{x:Bind Icon, Converter={StaticResource ObjectToVisibility}, Mode=OneWay}" />
                        <Border Background="{x:Bind MonogramBrush, Mode=OneTime}"
                                Visibility="{x:Bind Icon, Converter={StaticResource NullToVisibility}, Mode=OneWay}">
                            <TextBlock Text="{x:Bind Monogram, Mode=OneTime}"
                                       FontSize="16" FontWeight="SemiBold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- App info -->
                    <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind App.Name, Mode=OneTime}" FontSize="14" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind Version, Mode=OneTime}" FontSize="12" Opacity="0.6"/>
                            <FontIcon Glyph="&#xE72A;" FontSize="10" Opacity="0.6"/>
                            <TextBlock Text="{x:Bind LatestTag, Mode=OneTime}" FontSize="12" FontWeight="SemiBold" 
                                       Foreground="{StaticResource AccentBrush}"
                                       Visibility="{x:Bind UpdateAvailable, Mode=OneTime, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                        <TextBlock Text="{x:Bind SourceDisplay, Mode=OneTime}" FontSize="11" Opacity="0.5"/>
                    </StackPanel>

                    <!-- Check update button (only if not currently checking) -->
                    <Button Grid.Column="2"
                            Command="{Binding ViewModel.CheckSingleAppUpdateAsyncCommand, ElementName=PageRoot}"
                            CommandParameter="{x:Bind}"
                            Padding="10,5" CornerRadius="6" FontSize="12"
                            Background="{StaticResource CardBackgroundBrush}" BorderThickness="1"
                            ToolTipService.ToolTip="Проверить обновления">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                    </Button>

                    <!-- Uninstall from tracking button -->
                    <Button Grid.Column="3"
                            Command="{Binding ViewModel.RemoveTrackedAppAsyncCommand, ElementName=PageRoot}"
                            CommandParameter="{x:Bind}"
                            Padding="10,5" CornerRadius="6" FontSize="12"
                            Background="#26D83B01" BorderThickness="1"
                            ToolTipService.ToolTip="Удалить из отслеживания">
                        <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="#FFD83B01"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="16,16,16,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" ColumnSpacing="8" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Command="{Binding AddCustomAppAsyncCommand}"
                    AutomationProperties.Name="{x:Bind Loc.AddApp, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind Loc.AddApp, Mode=OneWay}"
                    Padding="12,6" CornerRadius="6" FontSize="12"
                    Background="{StaticResource CardBackgroundBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE710;" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="{x:Bind Loc.AddApp, Mode=OneWay}" FontSize="12"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Command="{Binding CheckUpdatesAsyncCommand}"
                    AutomationProperties.Name="{x:Bind Loc.QuickCheck, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind Loc.QuickCheck, Mode=OneWay}"
                    Padding="12,6" CornerRadius="6" FontSize="12"
                    Background="{StaticResource CardBackgroundBrush}" BorderThickness="1"
                    Content="{x:Bind Loc.QuickCheck, Mode=OneWay}"/>
        </Grid>

        <!-- Tracked apps list -->
        <ListView Grid.Row="1" x:Name="TrackedAppsList"
                  ItemsSource="{x:Bind ViewModel.Apps, Mode=OneWay}"
                  SelectionMode="None" ItemTemplate="{StaticResource TrackedAppItemTemplate}"/>

        <!-- Empty state -->
        <Border Grid.Row="1" Background="{StaticResource CardBackgroundBrush}" CornerRadius="8" Padding="24"
                Visibility="{x:Bind ViewModel.Apps.Count, Converter={StaticResource InverseCountToVisibility}, Mode=OneWay}"
                VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE710;" FontSize="24" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="{x:Bind Loc.NoTrackedApps, Mode=OneWay}" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                           HorizontalAlignment="Center" TextAlignment="Center"/>
                <Button Command="{Binding AddCustomAppAsyncCommand}"
                        Margin="0,8,0,0" Padding="16,8" CornerRadius="6"
                        Background="{StaticResource AccentBrush}" BorderThickness="0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" Foreground="White"/>
                        <TextBlock Text="{x:Bind Loc.AddApp, Mode=OneWay}" FontSize="13" Foreground="White"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>