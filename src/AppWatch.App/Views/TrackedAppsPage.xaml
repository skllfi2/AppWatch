<Page
    x:Class="AppWatch.Views.TrackedAppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:AppWatch.ViewModels"
    mc:Ignorable="d"
    Background="Transparent"
    NavigationCacheMode="Required"
    x:Name="PageRoot">
    <Page.Resources>
        <DataTemplate x:Key="TrackedAppItemTemplate" x:DataType="vm:TrackedAppItem">
            <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="10" Padding="14,12"
                    BorderThickness="1" BorderBrush="{StaticResource BorderDefaultBrush}"
                    Margin="0,3">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- App icon/avatar -->
                    <Grid Grid.Column="0" Width="42" Height="42" CornerRadius="8" VerticalAlignment="Center">
                        <Image Source="{x:Bind Icon, Mode=OneWay}"
                               Stretch="UniformToFill"
                               Visibility="{x:Bind Icon, Converter={StaticResource ObjectToVisibility}, Mode=OneWay}" />
                        <Border Background="{x:Bind MonogramBrush, Mode=OneTime}" CornerRadius="8"
                                Visibility="{x:Bind Icon, Converter={StaticResource NullToVisibility}, Mode=OneWay}">
                            <TextBlock Text="{x:Bind Monogram, Mode=OneTime}"
                                       FontSize="16" FontWeight="SemiBold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <!-- App info -->
                    <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind App.Name, Mode=OneTime}" FontSize="14" FontWeight="SemiBold"/>
                            <Border Background="{StaticResource NeutralSubtleBrush}"
                                    BorderBrush="{StaticResource NeutralPillBorderBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind SourceDisplay, Mode=OneTime}" FontSize="10" Opacity="0.75"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{x:Bind Description, Mode=OneWay}" FontSize="12" Opacity="0.7"
                                   TextTrimming="CharacterEllipsis" MaxLines="1"
                                   Visibility="{x:Bind HasDescription, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <!-- Current Version Pill -->
                            <Border Background="{StaticResource NeutralSubtleBrush}"
                                    BorderBrush="{StaticResource NeutralPillBorderBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Version, Mode=OneWay}" FontSize="11" Opacity="0.8"/>
                            </Border>
                            <!-- Update Transition Pill -->
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                        Visibility="{x:Bind UpdateAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <FontIcon Glyph="&#xE72A;" FontSize="10" Opacity="0.5" VerticalAlignment="Center"/>
                                <Border Background="{StaticResource AccentSubtleBrush}"
                                        BorderBrush="{StaticResource AccentPillBorderBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind LatestTag, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}"/>
                                </Border>
                            </StackPanel>
                            <!-- Status dot / text if not update available -->
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                        Visibility="{x:Bind UpdateAvailable, Converter={StaticResource InverseBoolToVisibility}, Mode=OneWay}">
                                <Ellipse Width="6" Height="6" Fill="{x:Bind StatusBrush, Mode=OneWay}" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <!-- Actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <!-- Update One Button -->
                        <Button Command="{x:Bind UpdateOneCommand}" CommandParameter="{x:Bind}"
                                AutomationProperties.Name="{x:Bind BtnUpdateOne, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind BtnUpdateOne, Mode=OneWay}"
                                Visibility="{x:Bind UpdateAvailable, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="12,6" FontSize="12">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE896;" FontSize="12"/>
                                <TextBlock Text="{x:Bind BtnUpdateOne, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <!-- Launch Button -->
                        <Button Command="{x:Bind LaunchAppCommand}" CommandParameter="{x:Bind}"
                                AutomationProperties.Name="{x:Bind BtnLaunch, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind BtnLaunch, Mode=OneWay}"
                                Visibility="{x:Bind CanLaunchPrimary, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                                Padding="12,6" CornerRadius="8" FontSize="12"
                                Background="{StaticResource CardBackgroundBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE768;" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="{x:Bind BtnLaunch, Mode=OneWay}" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <!-- Details / What's new button -->
                        <Button Command="{x:Bind ShowDetailsCommand}" CommandParameter="{x:Bind}"
                                Padding="8,6" CornerRadius="8" FontSize="12"
                                Background="{StaticResource CardBackgroundBrush}" BorderThickness="1"
                                ToolTipService.ToolTip="{x:Bind DetailsNotesText, Mode=OneWay}">
                            <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                        </Button>
                        <!-- Check update button -->
                        <Button Command="{Binding ViewModel.CheckSingleAppUpdateCommand, ElementName=PageRoot}"
                                CommandParameter="{x:Bind}"
                                Padding="8,6" CornerRadius="8" FontSize="12"
                                Background="{StaticResource CardBackgroundBrush}" BorderThickness="1"
                                ToolTipService.ToolTip="Проверить обновления">
                            <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Button>
                        <!-- More menu flyout button (Rollback, Edit, Pin, Skip, Uninstall) -->
                        <Button Padding="8,6" CornerRadius="8"
                                AutomationProperties.Name="{x:Bind MenuEdit, Mode=OneWay}"
                                Background="{StaticResource CardBackgroundBrush}" BorderThickness="1"
                                ToolTipService.ToolTip="{x:Bind MenuEdit, Mode=OneWay}">
                            <FontIcon Glyph="&#xE10C;" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Command="{x:Bind RollbackAppCommand}" CommandParameter="{x:Bind}"
                                                    Text="{x:Bind BtnRollback, Mode=OneWay}"
                                                    Visibility="{x:Bind RollbackAvailable, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE7A6;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Command="{x:Bind SkipVersionCommand}" CommandParameter="{x:Bind}"
                                                    Text="{x:Bind MenuSkipVersion, Mode=OneWay}"
                                                    Visibility="{x:Bind UpdateAvailable, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE7E3;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Command="{x:Bind PinCurrentCommand}" CommandParameter="{x:Bind}"
                                                    Text="{x:Bind MenuPinCurrent, Mode=OneWay}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE840;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Command="{x:Bind EditAppCommand}" CommandParameter="{x:Bind}"
                                                    Text="{x:Bind MenuEdit, Mode=OneWay}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE70F;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Command="{x:Bind RefreshAppIconCommand}" CommandParameter="{x:Bind}"
                                                    Text="{x:Bind MenuRefreshIcon, Mode=OneWay}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE72C;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>

                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Command="{x:Bind CreateStartMenuShortcutCommand}" CommandParameter="{x:Bind}"
                                                    Text="{x:Bind MenuStartMenuShortcut, Mode=OneWay}"
                                                    Visibility="{x:Bind HasLaunchInfo, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE71D;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Command="{x:Bind CreateDesktopShortcutCommand}" CommandParameter="{x:Bind}"
                                                    Text="{x:Bind MenuDesktopShortcut, Mode=OneWay}"
                                                    Visibility="{x:Bind HasLaunchInfo, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE774;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Command="{x:Bind ResetRulesCommand}" CommandParameter="{x:Bind}"
                                                    Text="{x:Bind MenuResetRules, Mode=OneWay}"
                                                    Visibility="{x:Bind RuleBadge, Converter={StaticResource StringNotEmptyToVisibility}, Mode=OneWay}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE74D;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Command="{x:Bind UninstallAppCommand}" CommandParameter="{x:Bind}"
                                                    Text="{x:Bind MenuUninstall, Mode=OneWay}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE74D;" Foreground="#FFD83B01"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>
    <Grid Padding="32,24" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{x:Bind Loc.TrackedApps, Mode=OneWay}" Style="{StaticResource PageHeaderStyle}"/>
            <TextBlock Text="{x:Bind Loc.AppsPageSubtitle, Mode=OneWay}" Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap"/>
        </StackPanel>
        <!-- Toolbar: Search + Sort + Actions, and Filter chips -->
        <Grid Grid.Row="1" RowSpacing="10" Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- Top Row: Search Box, Sort ComboBox, Add App, Scan System, Batch Import, Quick Check -->
            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{x:Bind ViewModel.TrackedAppsSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="{x:Bind Loc.SearchAppsPlaceholder, Mode=OneWay}"
                         Background="{StaticResource CardBackgroundBrush}" CornerRadius="8"
                         BorderThickness="1" Padding="12,7" FontSize="13"
                         VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" VerticalAlignment="Center" MinWidth="130"
                          SelectedIndex="{x:Bind ViewModel.SelectedAppsSortIndex, Mode=TwoWay}"
                          CornerRadius="8" Background="{StaticResource CardBackgroundBrush}"
                          Padding="10,6" FontSize="12">
                    <ComboBoxItem Content="{x:Bind Loc.SortByName, Mode=OneWay}"/>
                    <ComboBoxItem Content="{x:Bind Loc.SortByStatus, Mode=OneWay}"/>
                    <ComboBoxItem Content="{x:Bind Loc.SortBySource, Mode=OneWay}"/>
                </ComboBox>
                <Button Grid.Column="2" Command="{x:Bind ViewModel.AddCustomAppCommand}"
                        AutomationProperties.Name="{x:Bind Loc.AddApp, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind Loc.AddApp, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="12"/>
                        <TextBlock Text="{x:Bind Loc.AddApp, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="3" Command="{x:Bind ViewModel.ScanSystemCommand}"
                        AutomationProperties.Name="{x:Bind Loc.SystemScannerBtn, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind Loc.SystemScannerTooltip, Mode=OneWay}"
                        Padding="12,7" CornerRadius="8" FontSize="12"
                        Background="{StaticResource CardBackgroundBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE721;" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="{x:Bind Loc.SystemScannerBtn, Mode=OneWay}" FontSize="12"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="4" Command="{x:Bind ViewModel.ImportFromStarsCommand}"
                        AutomationProperties.Name="{x:Bind Loc.ImportFromStarsTitle, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind Loc.ImportFromStarsTitle, Mode=OneWay}"
                        Padding="12,7" CornerRadius="8" FontSize="12"
                        Background="{StaticResource CardBackgroundBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE734;" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="{x:Bind Loc.ImportFromStarsTitle, Mode=OneWay}" FontSize="12"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="5" Command="{x:Bind ViewModel.BatchImportCommand}"
                        AutomationProperties.Name="{x:Bind Loc.BatchImportBtn, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind Loc.BatchImportTitle, Mode=OneWay}"
                        Padding="12,7" CornerRadius="8" FontSize="12"
                        Background="{StaticResource CardBackgroundBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8B7;" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="{x:Bind Loc.BatchImportBtn, Mode=OneWay}" FontSize="12"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="6" Command="{x:Bind ViewModel.CheckUpdatesCommand}"
                        AutomationProperties.Name="{x:Bind Loc.QuickCheck, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind Loc.QuickCheck, Mode=OneWay}"
                        Padding="12,7" CornerRadius="8" FontSize="12"
                        Background="{StaticResource CardBackgroundBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="{x:Bind Loc.QuickCheck, Mode=OneWay}" FontSize="12"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="7" Command="{x:Bind ViewModel.RefreshAllIconsCommand}"
                        AutomationProperties.Name="{x:Bind Loc.BtnRefreshIcons, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind Loc.BtnRefreshIcons, Mode=OneWay}"
                        Padding="12,7" CornerRadius="8" FontSize="12"
                        Background="{StaticResource CardBackgroundBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE790;" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="{x:Bind Loc.BtnRefreshIcons, Mode=OneWay}" FontSize="12"/>
                    </StackPanel>
                </Button>
            </Grid>
            <!-- Bottom Row: Filter chips -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Command="{x:Bind ViewModel.SetFilterAllCommand}"
                            Content="{x:Bind ViewModel.FilterAllLabel, Mode=OneWay}"
                            Background="{x:Bind ViewModel.FilterAllBackground, Mode=OneWay}"
                            Foreground="{x:Bind ViewModel.FilterAllForeground, Mode=OneWay}"
                            Padding="12,5" CornerRadius="14" FontSize="12" BorderThickness="1"/>
                    <Button Command="{x:Bind ViewModel.SetFilterUpdatesCommand}"
                            Content="{x:Bind ViewModel.FilterUpdatesLabel, Mode=OneWay}"
                            Background="{x:Bind ViewModel.FilterUpdatesBackground, Mode=OneWay}"
                            Foreground="{x:Bind ViewModel.FilterUpdatesForeground, Mode=OneWay}"
                            Padding="12,5" CornerRadius="14" FontSize="12" BorderThickness="1"/>
                    <Button Command="{x:Bind ViewModel.SetFilterGitHubCommand}"
                            Content="{x:Bind ViewModel.FilterGitHubLabel, Mode=OneWay}"
                            Background="{x:Bind ViewModel.FilterGitHubBackground, Mode=OneWay}"
                            Foreground="{x:Bind ViewModel.FilterGitHubForeground, Mode=OneWay}"
                            Padding="12,5" CornerRadius="14" FontSize="12" BorderThickness="1"/>
                    <Button Command="{x:Bind ViewModel.SetFilterWingetCommand}"
                            Content="{x:Bind ViewModel.FilterWingetLabel, Mode=OneWay}"
                            Background="{x:Bind ViewModel.FilterWingetBackground, Mode=OneWay}"
                            Foreground="{x:Bind ViewModel.FilterWingetForeground, Mode=OneWay}"
                            Padding="12,5" CornerRadius="14" FontSize="12" BorderThickness="1"/>
                    <Button Command="{x:Bind ViewModel.SetFilterExternalCommand}"
                            Content="{x:Bind ViewModel.FilterExternalLabel, Mode=OneWay}"
                            Background="{x:Bind ViewModel.FilterExternalBackground, Mode=OneWay}"
                            Foreground="{x:Bind ViewModel.FilterExternalForeground, Mode=OneWay}"
                            Padding="12,5" CornerRadius="14" FontSize="12" BorderThickness="1"/>
                    <Button Command="{x:Bind ViewModel.SetFilterErrorsCommand}"
                            Content="{x:Bind ViewModel.FilterErrorsLabel, Mode=OneWay}"
                            Background="{x:Bind ViewModel.FilterErrorsBackground, Mode=OneWay}"
                            Foreground="{x:Bind ViewModel.FilterErrorsForeground, Mode=OneWay}"
                            Padding="12,5" CornerRadius="14" FontSize="12" BorderThickness="1"/>
                    <Button Command="{x:Bind ViewModel.SetFilterUpToDateCommand}"
                            Content="{x:Bind ViewModel.FilterUpToDateLabel, Mode=OneWay}"
                            Background="{x:Bind ViewModel.FilterUpToDateBackground, Mode=OneWay}"
                            Foreground="{x:Bind ViewModel.FilterUpToDateForeground, Mode=OneWay}"
                            Padding="12,5" CornerRadius="14" FontSize="12" BorderThickness="1"/>
                    <Button Command="{x:Bind ViewModel.SetFilterDisabledCommand}"
                            Content="{x:Bind ViewModel.FilterDisabledLabel, Mode=OneWay}"
                            Background="{x:Bind ViewModel.FilterDisabledBackground, Mode=OneWay}"
                            Foreground="{x:Bind ViewModel.FilterDisabledForeground, Mode=OneWay}"
                            Padding="12,5" CornerRadius="14" FontSize="12" BorderThickness="1"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- Active checking progress strip -->
            <Border Grid.Row="0" Margin="0,0,0,12"
                    Background="{StaticResource AccentSubtleBrush}" CornerRadius="10" Padding="16,12"
                    BorderThickness="1" BorderBrush="{StaticResource AccentPillBorderBrush}"
                    Visibility="{x:Bind ViewModel.IsCheckingApps, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ProgressRing Grid.Column="0" IsActive="{x:Bind ViewModel.IsCheckingApps, Mode=OneWay}" Width="20" Height="20" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                        <TextBlock Text="{x:Bind ViewModel.CheckingProgressText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"/>
                        <ProgressBar Value="{x:Bind ViewModel.CheckingProgressValue, Mode=OneWay}" Maximum="100" Height="4" CornerRadius="2"/>
                    </StackPanel>
                    <Button Grid.Column="2" Command="{x:Bind ViewModel.CancelCheckCommand}"
                            Content="{x:Bind Loc.BtnStop, Mode=OneWay}"
                            Padding="14,6" FontSize="12" CornerRadius="8"
                            Background="{StaticResource CardBackgroundBrush}" BorderThickness="1"/>
                </Grid>
            </Border>
            <!-- Tracked apps list -->
            <ListView Grid.Row="1" x:Name="TrackedAppsList"
                      ItemsSource="{x:Bind ViewModel.FilteredApps, Mode=OneWay}"
                      SelectionMode="None" ItemTemplate="{StaticResource TrackedAppItemTemplate}"/>
            <!-- Empty search/filter state -->
            <Border Grid.Row="1" Background="{StaticResource CardBackgroundBrush}" CornerRadius="12" Padding="32,28"
                    BorderThickness="1" BorderBrush="{StaticResource BorderDefaultBrush}"
                    Visibility="{x:Bind ViewModel.IsSearchActiveAndEmpty, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <Border Style="{StaticResource EmptyStateCircleStyle}">
                        <FontIcon Glyph="&#xE721;" FontSize="24" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{x:Bind Loc.NoMatchingApps, Mode=OneWay}" Style="{StaticResource EmptyStateTitleStyle}"/>
                    <TextBlock Text="{x:Bind Loc.NoMatchingAppsSubtitle, Mode=OneWay}" Style="{StaticResource EmptyStateSubtitleStyle}"/>
                    <Button Command="{x:Bind ViewModel.ResetAppsFilterCommand}"
                            Padding="16,8" CornerRadius="8" HorizontalAlignment="Center"
                            Background="{StaticResource AccentSubtleBrush}" BorderThickness="1" BorderBrush="{StaticResource AccentPillBorderBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="{x:Bind Loc.ResetFilters, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
            <!-- Empty total apps state -->
            <Border Grid.Row="1" Background="{StaticResource CardBackgroundBrush}" CornerRadius="12" Padding="32,28"
                    BorderThickness="1" BorderBrush="{StaticResource BorderDefaultBrush}"
                    Visibility="{x:Bind ViewModel.Apps.Count, Converter={StaticResource InverseCountToVisibility}, Mode=OneWay}"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <Border Style="{StaticResource EmptyStateCircleStyle}">
                        <FontIcon Glyph="&#xE710;" FontSize="26" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{x:Bind Loc.NoTrackedApps, Mode=OneWay}" Style="{StaticResource EmptyStateTitleStyle}"/>
                    <TextBlock Text="{x:Bind Loc.NoTrackedAppsSubtitle, Mode=OneWay}" Style="{StaticResource EmptyStateSubtitleStyle}"/>
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <Button Command="{x:Bind ViewModel.AddCustomAppCommand}"
                                Padding="16,8" CornerRadius="8"
                                Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="14" Foreground="White"/>
                                <TextBlock Text="{x:Bind Loc.AddApp, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind ViewModel.ScanSystemCommand}"
                                Padding="16,8" CornerRadius="8"
                                Background="{StaticResource CardBackgroundBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE721;" FontSize="14" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="{x:Bind Loc.SystemScannerBtn, Mode=OneWay}" FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
