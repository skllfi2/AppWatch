<Page
    x:Class="AppWatch.Views.TrackedAppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:AppWatch.ViewModels"
    mc:Ignorable="d"
    Background="Transparent"
    NavigationCacheMode="Required"
    x:Name="PageRoot">
    <Page.Resources>
        <DataTemplate x:Key="TrackedAppItemTemplate" x:DataType="vm:TrackedAppItem">
            <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="10" Padding="14,12"
                    BorderThickness="1" BorderBrush="{StaticResource BorderDefaultBrush}"
                    Margin="0,3">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Clickable Info area (icon + name + description) opening details dialog -->
                    <Button Grid.Column="0"
                            Command="{x:Bind ShowDetailsCommand}" CommandParameter="{x:Bind}"
                            Background="Transparent" BorderThickness="0" Padding="0" Margin="0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            CornerRadius="6">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- App icon/avatar -->
                            <Grid Grid.Column="0" Width="42" Height="42" CornerRadius="8" VerticalAlignment="Center">
                                <Image Source="{x:Bind Icon, Mode=OneWay}"
                                       Stretch="UniformToFill"
                                       Visibility="{x:Bind Icon, Converter={StaticResource ObjectToVisibility}, Mode=OneWay}" />
                                <Border Background="{x:Bind MonogramBrush, Mode=OneTime}" CornerRadius="8"
                                        Visibility="{x:Bind Icon, Converter={StaticResource NullToVisibility}, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind Monogram, Mode=OneTime}"
                                               FontSize="16" FontWeight="SemiBold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <!-- App info -->
                            <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind App.Name, Mode=OneTime}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <Border Background="{StaticResource NeutralSubtleBrush}"
                                            BorderBrush="{StaticResource NeutralPillBorderBrush}"
                                            BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind SourceDisplay, Mode=OneWay}" FontSize="10" Opacity="0.75"/>
                                    </Border>
                                    <Border Background="{StaticResource AccentSubtleBrush}"
                                            BorderBrush="{StaticResource AccentPillBorderBrush}"
                                            BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center"
                                            Visibility="{x:Bind HasCategory, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{x:Bind CategoryDisplay, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{x:Bind Description, Mode=OneWay}" FontSize="12" Opacity="0.7"
                                           TextTrimming="CharacterEllipsis" MaxLines="1"
                                           Visibility="{x:Bind HasDescription, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Column 1: Version Pill (120px) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Border Background="{StaticResource NeutralSubtleBrush}"
                                BorderBrush="{StaticResource NeutralPillBorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Version, Mode=OneWay}" FontSize="11" Opacity="0.85"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                    Visibility="{x:Bind UpdateAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="→" FontSize="11" Opacity="0.5" VerticalAlignment="Center"/>
                            <Border Background="{StaticResource AccentSubtleBrush}"
                                    BorderBrush="{StaticResource AccentPillBorderBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind LatestTag, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Column 2: Status Text with dot (180px) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Ellipse Width="7" Height="7" Fill="{x:Bind StatusBrush, Mode=OneWay}" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" FontSize="11" Opacity="0.8" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Dedicated Column 3: Actions (Launch / Update / Menu) -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <!-- Update One Button -->
                        <Button Command="{x:Bind UpdateOneCommand}" CommandParameter="{x:Bind}"
                                AutomationProperties.Name="{x:Bind BtnUpdateOne, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind BtnUpdateOne, Mode=OneWay}"
                                Visibility="{x:Bind UpdateAvailable, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="12,6" FontSize="12">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE896;" FontSize="12"/>
                                <TextBlock Text="{x:Bind BtnUpdateOne, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <!-- Launch Button -->
                        <Button Command="{x:Bind LaunchAppCommand}" CommandParameter="{x:Bind}"
                                AutomationProperties.Name="{x:Bind BtnLaunch, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind BtnLaunch, Mode=OneWay}"
                                Visibility="{x:Bind CanLaunchPrimary, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                                Padding="12,6" CornerRadius="8" FontSize="12"
                                Background="{StaticResource CardBackgroundBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE768;" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="{x:Bind BtnLaunch, Mode=OneWay}" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <!-- More menu flyout button (Check, Details, Rollback, Edit, Pin, Skip, Uninstall) -->
                        <Button Padding="8,6" CornerRadius="8"
                                AutomationProperties.Name="{x:Bind MenuEdit, Mode=OneWay}"
                                Background="{StaticResource CardBackgroundBrush}" BorderThickness="1"
                                ToolTipService.ToolTip="{x:Bind MenuEdit, Mode=OneWay}">
                            <FontIcon Glyph="&#xE10C;" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Command="{x:Bind CheckUpdateCommand}" CommandParameter="{x:Bind}"
                                                    Text="Проверить обновление">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE72C;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Command="{x:Bind ShowDetailsCommand}" CommandParameter="{x:Bind}"
                                                    Text="О программе / релизы">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE946;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Command="{x:Bind RollbackAppCommand}" CommandParameter="{x:Bind}"
                                                    Text="{x:Bind BtnRollback, Mode=OneWay}"
                                                    Visibility="{x:Bind RollbackAvailable, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE7A6;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Command="{x:Bind SkipVersionCommand}" CommandParameter="{x:Bind}"
                                                    Text="{x:Bind MenuSkipVersion, Mode=OneWay}"
                                                    Visibility="{x:Bind UpdateAvailable, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE7E3;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Command="{x:Bind PinCurrentCommand}" CommandParameter="{x:Bind}"
                                                    Text="{x:Bind MenuPinCurrent, Mode=OneWay}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE840;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Command="{x:Bind EditAppCommand}" CommandParameter="{x:Bind}"
                                                    Text="{x:Bind MenuEdit, Mode=OneWay}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE70F;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Command="{x:Bind RefreshAppIconCommand}" CommandParameter="{x:Bind}"
                                                    Text="{x:Bind MenuRefreshIcon, Mode=OneWay}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE72C;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>

                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Command="{x:Bind CreateStartMenuShortcutCommand}" CommandParameter="{x:Bind}"
                                                    Text="{x:Bind MenuStartMenuShortcut, Mode=OneWay}"
                                                    Visibility="{x:Bind HasLaunchInfo, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE71D;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Command="{x:Bind CreateDesktopShortcutCommand}" CommandParameter="{x:Bind}"
                                                    Text="{x:Bind MenuDesktopShortcut, Mode=OneWay}"
                                                    Visibility="{x:Bind HasLaunchInfo, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE774;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Command="{x:Bind ResetRulesCommand}" CommandParameter="{x:Bind}"
                                                    Text="{x:Bind MenuResetRules, Mode=OneWay}"
                                                    Visibility="{x:Bind RuleBadge, Converter={StaticResource StringNotEmptyToVisibility}, Mode=OneWay}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE74D;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Command="{x:Bind UninstallAppCommand}" CommandParameter="{x:Bind}"
                                                    Text="{x:Bind MenuUninstall, Mode=OneWay}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE74D;" Foreground="#FFD83B01"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="TrackedAppCompactItemTemplate" x:DataType="vm:TrackedAppItem">
            <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="8" Padding="12,8"
                    BorderThickness="1" BorderBrush="{StaticResource BorderDefaultBrush}" Margin="0,2">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Col 0: Clickable App info (Icon + Name + Source Badge + Category) -->
                    <Button Grid.Column="0" Command="{x:Bind ShowDetailsCommand}" CommandParameter="{x:Bind}"
                            Background="Transparent" BorderThickness="0" Padding="0" Margin="0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <!-- Small icon -->
                            <Grid Width="28" Height="28" CornerRadius="6" VerticalAlignment="Center">
                                <Image Source="{x:Bind Icon, Mode=OneWay}" Stretch="UniformToFill"
                                       Visibility="{x:Bind Icon, Converter={StaticResource ObjectToVisibility}, Mode=OneWay}"/>
                                <Border Background="{x:Bind MonogramBrush, Mode=OneTime}" CornerRadius="6"
                                        Visibility="{x:Bind Icon, Converter={StaticResource NullToVisibility}, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind Monogram, Mode=OneTime}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <!-- Name & Source -->
                            <TextBlock Text="{x:Bind App.Name, Mode=OneTime}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Border Background="{StaticResource NeutralSubtleBrush}" BorderBrush="{StaticResource NeutralPillBorderBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind SourceDisplay, Mode=OneWay}" FontSize="10" Opacity="0.75"/>
                            </Border>
                            <Border Background="{StaticResource AccentSubtleBrush}" BorderBrush="{StaticResource AccentPillBorderBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="5,1" VerticalAlignment="Center"
                                    Visibility="{x:Bind HasCategory, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{x:Bind CategoryDisplay, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <!-- Col 1: Version Pill (Fixed 130px column) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Border Background="{StaticResource NeutralSubtleBrush}" BorderBrush="{StaticResource NeutralPillBorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Version, Mode=OneWay}" FontSize="11" Opacity="0.85"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                    Visibility="{x:Bind UpdateAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="→" FontSize="11" Opacity="0.5" VerticalAlignment="Center"/>
                            <Border Background="{StaticResource AccentSubtleBrush}" BorderBrush="{StaticResource AccentPillBorderBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind LatestTag, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Col 2: Status text with colored dot (Fixed 180px column) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Ellipse Width="7" Height="7" Fill="{x:Bind StatusBrush, Mode=OneWay}" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" FontSize="11" Opacity="0.8" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Col 3: Actions (Launch / Update / Menu) -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Command="{x:Bind UpdateOneCommand}" CommandParameter="{x:Bind}"
                                Visibility="{x:Bind UpdateAvailable, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}" Padding="10,4" FontSize="11">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE896;" FontSize="11"/>
                                <TextBlock Text="{x:Bind BtnUpdateOne, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind LaunchAppCommand}" CommandParameter="{x:Bind}"
                                Visibility="{x:Bind CanLaunchPrimary, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                                Padding="8,4" CornerRadius="6" FontSize="11" Background="{StaticResource CardBackgroundBrush}" BorderThickness="1">
                            <FontIcon Glyph="&#xE768;" FontSize="11" Foreground="{StaticResource AccentBrush}"/>
                        </Button>
                        <!-- More menu flyout button -->
                        <Button Padding="6,4" CornerRadius="6"
                                Background="{StaticResource CardBackgroundBrush}" BorderThickness="1">
                            <FontIcon Glyph="&#xE10C;" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Command="{x:Bind CheckUpdateCommand}" CommandParameter="{x:Bind}"
                                                    Text="Проверить обновление">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE72C;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Command="{x:Bind ShowDetailsCommand}" CommandParameter="{x:Bind}"
                                                    Text="О программе / релизы">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE946;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Command="{x:Bind RollbackAppCommand}" CommandParameter="{x:Bind}"
                                                    Text="{x:Bind BtnRollback, Mode=OneWay}"
                                                    Visibility="{x:Bind RollbackAvailable, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE7A6;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Command="{x:Bind SkipVersionCommand}" CommandParameter="{x:Bind}"
                                                    Text="{x:Bind MenuSkipVersion, Mode=OneWay}"
                                                    Visibility="{x:Bind UpdateAvailable, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE7E3;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Command="{x:Bind PinCurrentCommand}" CommandParameter="{x:Bind}"
                                                    Text="{x:Bind MenuPinCurrent, Mode=OneWay}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE840;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Command="{x:Bind EditAppCommand}" CommandParameter="{x:Bind}"
                                                    Text="{x:Bind MenuEdit, Mode=OneWay}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE70F;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Command="{x:Bind UninstallAppCommand}" CommandParameter="{x:Bind}"
                                                    Text="{x:Bind MenuUninstall, Mode=OneWay}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE74D;" Foreground="#FFD83B01"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
</Page.Resources>
    <Grid Padding="32,24" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{x:Bind Loc.TrackedApps, Mode=OneWay}" Style="{StaticResource PageHeaderStyle}"/>
            <TextBlock Text="{x:Bind Loc.AppsPageSubtitle, Mode=OneWay}" Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap"/>
        </StackPanel>
        <!-- Toolbar: Search + Sort + Actions, and Filter chips -->
        <Grid Grid.Row="1" RowSpacing="10" Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- Top Row: Search Box, Sort ComboBox, Add App DropDown, Quick Check, Refresh, View Mode -->
            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{x:Bind ViewModel.TrackedAppsSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="{x:Bind Loc.SearchAppsPlaceholder, Mode=OneWay}"
                         Background="{StaticResource CardBackgroundBrush}" CornerRadius="8"
                         BorderThickness="1" Padding="12,7" FontSize="13"
                         VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" VerticalAlignment="Center" MinWidth="130"
                          SelectedIndex="{x:Bind ViewModel.SelectedAppsSortIndex, Mode=TwoWay}" MinHeight="36" CornerRadius="8" Background="{StaticResource CardBackgroundBrush}" Padding="10,6" FontSize="12">
                    <ComboBoxItem Content="{x:Bind Loc.SortByName, Mode=OneWay}"/>
                    <ComboBoxItem Content="{x:Bind Loc.SortByStatus, Mode=OneWay}"/>
                    <ComboBoxItem Content="{x:Bind Loc.SortBySource, Mode=OneWay}"/>
                    <ComboBoxItem Content="{x:Bind Loc.SortByCategory, Mode=OneWay}"/>
                </ComboBox>

                <!-- Add App with dropdown menu for Scan and Imports -->
                <DropDownButton Grid.Column="2" Style="{StaticResource AccentButtonStyle}" MinHeight="36" Padding="12,6" CornerRadius="8">
                    <DropDownButton.Content>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="12"/>
                            <TextBlock Text="{x:Bind Loc.AddApp, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </DropDownButton.Content>
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Command="{x:Bind ViewModel.AddCustomAppCommand}" Text="{x:Bind Loc.AddApp, Mode=OneWay}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE710;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Command="{x:Bind ViewModel.ScanSystemCommand}" Text="{x:Bind Loc.SystemScannerBtn, Mode=OneWay}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE721;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Command="{x:Bind ViewModel.ImportFromStarsCommand}" Text="{x:Bind Loc.ImportFromStarsTitle, Mode=OneWay}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE734;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Command="{x:Bind ViewModel.BatchImportCommand}" Text="{x:Bind Loc.BatchImportBtn, Mode=OneWay}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8B7;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <!-- Check Updates Button with Progress Ring -->
                <Button Grid.Column="3" Command="{x:Bind ViewModel.CheckUpdatesCommand}"
                        AutomationProperties.Name="{x:Bind Loc.QuickCheck, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind Loc.QuickCheck, Mode=OneWay}"
                        Padding="12,6" MinHeight="36" CornerRadius="8" FontSize="12"
                        Background="{StaticResource CardBackgroundBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ProgressRing IsActive="{x:Bind ViewModel.IsCheckingApps, Mode=OneWay}"
                                      Width="12" Height="12"
                                      Visibility="{x:Bind ViewModel.IsCheckingApps, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                        <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="{StaticResource AccentBrush}"
                                  Visibility="{x:Bind ViewModel.IsCheckingApps, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}"/>
                        <TextBlock Text="{x:Bind Loc.QuickCheck, Mode=OneWay}" FontSize="12"/>
                    </StackPanel>
                </Button>

                <!-- Refresh Icons -->
                <Button Grid.Column="4" Command="{x:Bind ViewModel.RefreshAllIconsCommand}"
                        AutomationProperties.Name="{x:Bind Loc.BtnRefreshIcons, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind Loc.BtnRefreshIcons, Mode=OneWay}"
                        Padding="10,6" MinHeight="36" CornerRadius="8" FontSize="12"
                        Background="{StaticResource CardBackgroundBrush}" BorderThickness="1">
                    <FontIcon Glyph="&#xE790;" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                </Button>

                <!-- View Mode Toggle (Cards / Compact Table) -->
                <Border Grid.Column="5" Background="{StaticResource CardBackgroundBrush}" CornerRadius="8"
                        BorderThickness="1" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="2">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Command="{x:Bind ViewModel.SetCardsViewCommand}"
                                ToolTipService.ToolTip="{x:Bind Loc.ViewCards, Mode=OneWay}"
                                Padding="8,5" CornerRadius="6"
                                Background="{x:Bind ViewModel.CardsViewButtonBackground, Mode=OneWay}">
                            <FontIcon Glyph="&#xE8A9;" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Button>
                        <Button Command="{x:Bind ViewModel.SetCompactViewCommand}"
                                ToolTipService.ToolTip="{x:Bind Loc.ViewCompact, Mode=OneWay}"
                                Padding="8,5" CornerRadius="6"
                                Background="{x:Bind ViewModel.CompactViewButtonBackground, Mode=OneWay}">
                            <FontIcon Glyph="&#xE80A;" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
            <!-- Bottom Row: Filter chips -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Command="{x:Bind ViewModel.SetFilterAllCommand}"
                            Content="{x:Bind ViewModel.FilterAllLabel, Mode=OneWay}"
                            Background="{x:Bind ViewModel.FilterAllBackground, Mode=OneWay}"
                            Foreground="{x:Bind ViewModel.FilterAllForeground, Mode=OneWay}"
                            Padding="12,5" CornerRadius="14" FontSize="12" BorderThickness="1"/>
                    <Button Command="{x:Bind ViewModel.SetFilterUpdatesCommand}"
                            Content="{x:Bind ViewModel.FilterUpdatesLabel, Mode=OneWay}"
                            Background="{x:Bind ViewModel.FilterUpdatesBackground, Mode=OneWay}"
                            Foreground="{x:Bind ViewModel.FilterUpdatesForeground, Mode=OneWay}"
                            Padding="12,5" CornerRadius="14" FontSize="12" BorderThickness="1"/>
                    <Button Command="{x:Bind ViewModel.SetFilterGitHubCommand}"
                            Content="{x:Bind ViewModel.FilterGitHubLabel, Mode=OneWay}"
                            Background="{x:Bind ViewModel.FilterGitHubBackground, Mode=OneWay}"
                            Foreground="{x:Bind ViewModel.FilterGitHubForeground, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasFilterGitHub, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Padding="12,5" CornerRadius="14" FontSize="12" BorderThickness="1"/>
                    <Button Command="{x:Bind ViewModel.SetFilterWingetCommand}"
                            Content="{x:Bind ViewModel.FilterWingetLabel, Mode=OneWay}"
                            Background="{x:Bind ViewModel.FilterWingetBackground, Mode=OneWay}"
                            Foreground="{x:Bind ViewModel.FilterWingetForeground, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasFilterWinget, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Padding="12,5" CornerRadius="14" FontSize="12" BorderThickness="1"/>
                    <Button Command="{x:Bind ViewModel.SetFilterExternalCommand}"
                            Content="{x:Bind ViewModel.FilterExternalLabel, Mode=OneWay}"
                            Background="{x:Bind ViewModel.FilterExternalBackground, Mode=OneWay}"
                            Foreground="{x:Bind ViewModel.FilterExternalForeground, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasFilterExternal, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Padding="12,5" CornerRadius="14" FontSize="12" BorderThickness="1"/>
                    <Button Command="{x:Bind ViewModel.SetFilterErrorsCommand}"
                            Content="{x:Bind ViewModel.FilterErrorsLabel, Mode=OneWay}"
                            Background="{x:Bind ViewModel.FilterErrorsBackground, Mode=OneWay}"
                            Foreground="{x:Bind ViewModel.FilterErrorsForeground, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasFilterErrors, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Padding="12,5" CornerRadius="14" FontSize="12" BorderThickness="1"/>
                    <Button Command="{x:Bind ViewModel.SetFilterUpToDateCommand}"
                            Content="{x:Bind ViewModel.FilterUpToDateLabel, Mode=OneWay}"
                            Background="{x:Bind ViewModel.FilterUpToDateBackground, Mode=OneWay}"
                            Foreground="{x:Bind ViewModel.FilterUpToDateForeground, Mode=OneWay}"
                            Padding="12,5" CornerRadius="14" FontSize="12" BorderThickness="1"/>
                    <Button Command="{x:Bind ViewModel.SetFilterDisabledCommand}"
                            Content="{x:Bind ViewModel.FilterDisabledLabel, Mode=OneWay}"
                            Background="{x:Bind ViewModel.FilterDisabledBackground, Mode=OneWay}"
                            Foreground="{x:Bind ViewModel.FilterDisabledForeground, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasFilterDisabled, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Padding="12,5" CornerRadius="14" FontSize="12" BorderThickness="1"/>
                    <Border Width="1" Height="16" Background="{StaticResource BorderDefaultBrush}" Margin="2,0"
                            Visibility="{x:Bind ViewModel.HasFilterGitVerse, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                    <Button Command="{x:Bind ViewModel.SetFilterGitVerseCommand}"
                            Content="{x:Bind ViewModel.FilterGitVerseLabel, Mode=OneWay}"
                            Background="{x:Bind ViewModel.FilterGitVerseBackground, Mode=OneWay}"
                            Foreground="{x:Bind ViewModel.FilterGitVerseForeground, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasFilterGitVerse, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Padding="12,5" CornerRadius="14" FontSize="12" BorderThickness="1"/>
                    <Button Command="{x:Bind ViewModel.SetFilterGitLabCommand}"
                            Content="{x:Bind ViewModel.FilterGitLabLabel, Mode=OneWay}"
                            Background="{x:Bind ViewModel.FilterGitLabBackground, Mode=OneWay}"
                            Foreground="{x:Bind ViewModel.FilterGitLabForeground, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasFilterGitLab, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Padding="12,5" CornerRadius="14" FontSize="12" BorderThickness="1"/>
                    <Button Command="{x:Bind ViewModel.SetFilterInPlaceCommand}"
                            Content="{x:Bind ViewModel.FilterInPlaceLabel, Mode=OneWay}"
                            Background="{x:Bind ViewModel.FilterInPlaceBackground, Mode=OneWay}"
                            Foreground="{x:Bind ViewModel.FilterInPlaceForeground, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasFilterInPlace, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Padding="12,5" CornerRadius="14" FontSize="12" BorderThickness="1"/>
                    <Border Width="1" Height="16" Background="{StaticResource BorderDefaultBrush}" Margin="2,0"
                            Visibility="{x:Bind ViewModel.HasFilterCategoryDev, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                    <Button Command="{x:Bind ViewModel.SetFilterCategoryDevCommand}"
                            Content="{x:Bind ViewModel.FilterCategoryDevLabel, Mode=OneWay}"
                            Background="{x:Bind ViewModel.FilterCategoryDevBackground, Mode=OneWay}"
                            Foreground="{x:Bind ViewModel.FilterCategoryDevForeground, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasFilterCategoryDev, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Padding="12,5" CornerRadius="14" FontSize="12" BorderThickness="1"/>
                    <Button Command="{x:Bind ViewModel.SetFilterCategoryAiCommand}"
                            Content="{x:Bind ViewModel.FilterCategoryAiLabel, Mode=OneWay}"
                            Background="{x:Bind ViewModel.FilterCategoryAiBackground, Mode=OneWay}"
                            Foreground="{x:Bind ViewModel.FilterCategoryAiForeground, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasFilterCategoryAi, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Padding="12,5" CornerRadius="14" FontSize="12" BorderThickness="1"/>
                    <Button Command="{x:Bind ViewModel.SetFilterCategorySystemCommand}"
                            Content="{x:Bind ViewModel.FilterCategorySystemLabel, Mode=OneWay}"
                            Background="{x:Bind ViewModel.FilterCategorySystemBackground, Mode=OneWay}"
                            Foreground="{x:Bind ViewModel.FilterCategorySystemForeground, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasFilterCategorySystem, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Padding="12,5" CornerRadius="14" FontSize="12" BorderThickness="1"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- Active checking progress strip -->
            <Border Grid.Row="0" Margin="0,0,0,12"
                    Background="{StaticResource AccentSubtleBrush}" CornerRadius="10" Padding="16,12"
                    BorderThickness="1" BorderBrush="{StaticResource AccentPillBorderBrush}"
                    Visibility="{x:Bind ViewModel.IsCheckingApps, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ProgressRing Grid.Column="0" IsActive="{x:Bind ViewModel.IsCheckingApps, Mode=OneWay}" Width="20" Height="20" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                        <TextBlock Text="{x:Bind ViewModel.CheckingProgressText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"/>
                        <ProgressBar Value="{x:Bind ViewModel.CheckingProgressValue, Mode=OneWay}" Maximum="100" Height="4" CornerRadius="2"/>
                    </StackPanel>
                    <Button Grid.Column="2" Command="{x:Bind ViewModel.CancelCheckCommand}"
                            Content="{x:Bind Loc.BtnStop, Mode=OneWay}"
                            Padding="14,6" FontSize="12" CornerRadius="8"
                            Background="{StaticResource CardBackgroundBrush}" BorderThickness="1"/>
                </Grid>
            </Border>
            <!-- Tracked apps list (Standard Cards) -->
            <ListView Grid.Row="1" x:Name="TrackedAppsList"
                      ItemsSource="{x:Bind ViewModel.FilteredApps, Mode=OneWay}"
                      SelectionMode="None" ItemTemplate="{StaticResource TrackedAppItemTemplate}"
                      Visibility="{x:Bind ViewModel.IsCardsView, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
            <!-- Tracked apps list (Compact Table) -->
            <ListView Grid.Row="1" x:Name="TrackedAppsCompactList"
                      ItemsSource="{x:Bind ViewModel.FilteredApps, Mode=OneWay}"
                      SelectionMode="None" ItemTemplate="{StaticResource TrackedAppCompactItemTemplate}"
                      Visibility="{x:Bind ViewModel.IsCompactView, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
            <!-- Empty search/filter state -->
            <Border Grid.Row="1" Background="{StaticResource CardBackgroundBrush}" CornerRadius="12" Padding="32,28"
                    BorderThickness="1" BorderBrush="{StaticResource BorderDefaultBrush}"
                    Visibility="{x:Bind ViewModel.IsSearchActiveAndEmpty, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <Border Style="{StaticResource EmptyStateCircleStyle}">
                        <FontIcon Glyph="&#xE721;" FontSize="24" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{x:Bind Loc.NoMatchingApps, Mode=OneWay}" Style="{StaticResource EmptyStateTitleStyle}"/>
                    <TextBlock Text="{x:Bind Loc.NoMatchingAppsSubtitle, Mode=OneWay}" Style="{StaticResource EmptyStateSubtitleStyle}"/>
                    <Button Command="{x:Bind ViewModel.ResetAppsFilterCommand}"
                            Padding="16,8" CornerRadius="8" HorizontalAlignment="Center"
                            Background="{StaticResource AccentSubtleBrush}" BorderThickness="1" BorderBrush="{StaticResource AccentPillBorderBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="{x:Bind Loc.ResetFilters, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
            <!-- Empty total apps state -->
            <Border Grid.Row="1" Background="{StaticResource CardBackgroundBrush}" CornerRadius="12" Padding="32,28"
                    BorderThickness="1" BorderBrush="{StaticResource BorderDefaultBrush}"
                    Visibility="{x:Bind ViewModel.Apps.Count, Converter={StaticResource InverseCountToVisibility}, Mode=OneWay}"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <Border Style="{StaticResource EmptyStateCircleStyle}">
                        <FontIcon Glyph="&#xE710;" FontSize="26" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{x:Bind Loc.NoTrackedApps, Mode=OneWay}" Style="{StaticResource EmptyStateTitleStyle}"/>
                    <TextBlock Text="{x:Bind Loc.NoTrackedAppsSubtitle, Mode=OneWay}" Style="{StaticResource EmptyStateSubtitleStyle}"/>
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <Button Command="{x:Bind ViewModel.AddCustomAppCommand}"
                                Padding="16,8" CornerRadius="8"
                                Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="14" Foreground="White"/>
                                <TextBlock Text="{x:Bind Loc.AddApp, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind ViewModel.ScanSystemCommand}"
                                Padding="16,8" CornerRadius="8"
                                Background="{StaticResource CardBackgroundBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE721;" FontSize="14" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="{x:Bind Loc.SystemScannerBtn, Mode=OneWay}" FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
