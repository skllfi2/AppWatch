<Page

    x:Class="AppWatch.Views.WingetPage"

    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    xmlns:vm="using:AppWatch.ViewModels"

    Background="Transparent"

    NavigationCacheMode="Required">

    <Grid Padding="32,24" RowSpacing="0">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto" />

            <RowDefinition Height="*" />

        </Grid.RowDefinitions>

        <!-- Header (navigation lives in the MainWindow NavigationView pane) -->

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">

            <StackPanel Spacing="4">

                <TextBlock Text="{x:Bind Loc.WingetUpdates, Mode=OneWay}" Style="{StaticResource PageHeaderStyle}" />

                <TextBlock Text="{x:Bind Loc.WingetPageSubtitle, Mode=OneWay}" Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap" />

            </StackPanel>

        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

                    <StackPanel Spacing="16">

                        <!-- Winget Updates List (ZuiV2 card rows with checkboxes) -->

                <StackPanel Spacing="8">

                    <Grid ColumnSpacing="8">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*" />

                            <ColumnDefinition Width="Auto" />

                            <ColumnDefinition Width="Auto" />

                            <ColumnDefinition Width="Auto" />

                            <ColumnDefinition Width="Auto" />

                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" Margin="4,0" VerticalAlignment="Center">

                            <FontIcon Glyph="&#xE753;" FontSize="14" Foreground="{StaticResource AccentBrush}"/>

                            <TextBlock Text="{x:Bind Loc.WingetUpdates, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"

                                       Foreground="{StaticResource TextSecondaryBrush}" CharacterSpacing="40"/>

                        </StackPanel>

                        <!-- Select all -->

                        <Button Grid.Column="1" Command="{x:Bind ViewModel.SelectAllWingetCommand}"

                                AutomationProperties.Name="{x:Bind Loc.WingetSelectAll, Mode=OneWay}"

                                ToolTipService.ToolTip="{x:Bind Loc.WingetSelectAll, Mode=OneWay}"

                                Padding="10,6" CornerRadius="8"

                                Background="{StaticResource CardBackgroundBrush}" BorderThickness="1"

                                Visibility="{x:Bind ViewModel.WingetUpdates.Count, Converter={StaticResource CountToVisibility}, Mode=OneWay}">

                            <StackPanel Orientation="Horizontal" Spacing="6">

                                <FontIcon Glyph="&#xE8B3;" FontSize="12" Foreground="{StaticResource AccentBrush}"/>

                                <TextBlock Text="{x:Bind Loc.WingetSelectAll, Mode=OneWay}" FontSize="11"/>

                            </StackPanel>

                        </Button>

                        <!-- Deselect all -->

                        <Button Grid.Column="2" Command="{x:Bind ViewModel.DeselectAllWingetCommand}"

                                AutomationProperties.Name="{x:Bind Loc.WingetDeselectAll, Mode=OneWay}"

                                ToolTipService.ToolTip="{x:Bind Loc.WingetDeselectAll, Mode=OneWay}"

                                Padding="10,6" CornerRadius="8"

                                Background="{StaticResource CardBackgroundBrush}" BorderThickness="1"

                                Visibility="{x:Bind ViewModel.WingetUpdates.Count, Converter={StaticResource CountToVisibility}, Mode=OneWay}">

                            <StackPanel Orientation="Horizontal" Spacing="6">

                                <FontIcon Glyph="&#xE8E6;" FontSize="12" Foreground="{StaticResource AccentBrush}"/>

                                <TextBlock Text="{x:Bind Loc.WingetDeselectAll, Mode=OneWay}" FontSize="11"/>

                            </StackPanel>

                        </Button>

                        <!-- Audit fix: UpdateSelectedWingetCommand was dead — checkboxes existed with no button -->

                        <Button Grid.Column="3" Command="{x:Bind ViewModel.UpdateSelectedWingetCommand}"

                                AutomationProperties.Name="{x:Bind Loc.WingetUpdateSelected, Mode=OneWay}"

                                ToolTipService.ToolTip="{x:Bind Loc.WingetUpdateSelected, Mode=OneWay}"

                                Padding="12,6" CornerRadius="8"

                                Background="{StaticResource CardBackgroundBrush}" BorderThickness="1"

                                Visibility="{x:Bind ViewModel.WingetUpdates.Count, Converter={StaticResource CountToVisibility}, Mode=OneWay}">

                            <StackPanel Orientation="Horizontal" Spacing="6">

                                <FontIcon Glyph="&#xE896;" FontSize="12" Foreground="{StaticResource AccentBrush}"/>

                                <TextBlock Text="{x:Bind Loc.WingetUpdateSelected, Mode=OneWay}" FontSize="11"/>

                            </StackPanel>

                        </Button>

                        <!-- Audit fix: ScanWingetCommand was dead — the empty state told users to scan with no button -->

                        <Button Grid.Column="4" Command="{x:Bind ViewModel.ScanWingetCommand}"

                                AutomationProperties.Name="{x:Bind Loc.WingetScan, Mode=OneWay}"

                                ToolTipService.ToolTip="{x:Bind Loc.WingetScan, Mode=OneWay}"

                                IsEnabled="{x:Bind ViewModel.IsScanningWinget, Converter={StaticResource InverseBool}, Mode=OneWay}"

                                Padding="12,6" CornerRadius="8"

                                Background="{StaticResource CardBackgroundBrush}" BorderThickness="1"

                                Visibility="{x:Bind ViewModel.WingetAvailable, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">

                            <StackPanel Orientation="Horizontal" Spacing="6">

                                <ProgressRing IsActive="{x:Bind ViewModel.IsScanningWinget, Mode=OneWay}" Width="12" Height="12"

                                              Visibility="{x:Bind ViewModel.IsScanningWinget, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"/>

                                <FontIcon Glyph="&#xE895;" FontSize="12" Foreground="{StaticResource AccentBrush}"

                                          Visibility="{x:Bind ViewModel.IsScanningWinget, Converter={StaticResource InverseBoolToVisibility}, Mode=OneWay}"/>

                                <TextBlock Text="{x:Bind Loc.WingetScan, Mode=OneWay}" FontSize="11"/>

                            </StackPanel>

                        </Button>

                    </Grid>

                    <!-- Active Winget scanning progress banner -->

                    <Border Background="{StaticResource HeroOverlayBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,8"

                            BorderThickness="1" BorderBrush="{StaticResource BorderDefaultBrush}"

                            Visibility="{x:Bind ViewModel.IsScanningWinget, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">

                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">

                            <ProgressRing IsActive="{x:Bind ViewModel.IsScanningWinget, Mode=OneWay}" Width="16" Height="16"/>

                            <TextBlock Text="{x:Bind Loc.WingetScanningDetail, Mode=OneWay}" FontSize="12" VerticalAlignment="Center"/>

                        </StackPanel>

                    </Border>

                    <ListView ItemsSource="{x:Bind ViewModel.WingetUpdates, Mode=OneWay}" SelectionMode="None">

                        <ListView.ItemTemplate>

                            <DataTemplate x:DataType="vm:WingetItem">
                                <Grid Padding="12" ColumnSpacing="12" Margin="0,0,0,8"
                                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                      BorderThickness="1" CornerRadius="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,12,0">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Status, Mode=OneWay}" Opacity="0.7" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <Border Background="{StaticResource NeutralSubtleBrush}"
                                                BorderBrush="{StaticResource NeutralPillBorderBrush}"
                                                BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind CurrentVersion}" FontSize="11" Opacity="0.8" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="→" FontSize="11" Opacity="0.5" VerticalAlignment="Center" />
                                        <Border Background="{StaticResource AccentSubtleBrush}"
                                                BorderBrush="{StaticResource AccentPillBorderBrush}"
                                                BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind AvailableVersion}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>

                                    <!-- live clock while winget works -->
                                    <TextBlock Grid.Column="3" Text="{x:Bind ElapsedText, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,12,0"
                                               FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"
                                               Visibility="{x:Bind ElapsedText, Converter={StaticResource StringNotEmptyToVisibility}, Mode=OneWay}"/>

                                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="4" MinWidth="150"
                                                Visibility="{x:Bind IsUpdating, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{x:Bind ProgressText, Mode=OneWay}"
                                                   FontSize="11" HorizontalAlignment="Right"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Visibility="{x:Bind ProgressText, Converter={StaticResource StringNotEmptyToVisibility}, Mode=OneWay}"/>
                                        <ProgressBar MinWidth="140" Height="8"
                                                     IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                                                     Maximum="100"
                                                     Value="{x:Bind ProgressValue, Mode=OneWay}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>

                        </ListView.ItemTemplate>

                    </ListView>

                    <!-- Empty state: winget unavailable -->

                    <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="12" Padding="32,28"

                            BorderThickness="1" BorderBrush="{StaticResource BorderDefaultBrush}"

                            Visibility="{x:Bind ViewModel.WingetAvailable, Converter={StaticResource InverseBoolToVisibility}, Mode=OneWay}">

                        <StackPanel Spacing="6" HorizontalAlignment="Center">

                            <Border Style="{StaticResource EmptyStateCircleStyle}" Background="{StaticResource CriticalSubtleBrush}">

                                <FontIcon Glyph="&#xE7E7;" FontSize="26" Foreground="{StaticResource ErrorColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            </Border>

                            <TextBlock Text="{x:Bind Loc.WingetNotAvailable, Mode=OneWay}" Style="{StaticResource EmptyStateTitleStyle}"/>

                            <TextBlock Text="{x:Bind Loc.WingetUnavailable, Mode=OneWay}" Style="{StaticResource EmptyStateSubtitleStyle}"/>

                        </StackPanel>

                    </Border>

                    <!-- Empty state: no updates after scan -->

                    <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="12" Padding="32,28"

                            BorderThickness="1" BorderBrush="{StaticResource BorderDefaultBrush}"

                            Visibility="{x:Bind ViewModel.WingetUpdates.Count, Converter={StaticResource InverseCountToVisibility}, Mode=OneWay}">

                        <StackPanel Spacing="6" HorizontalAlignment="Center">

                            <Border Style="{StaticResource EmptyStateCircleStyle}" Background="{StaticResource SuccessSubtleBrush}">

                                <FontIcon Glyph="&#xE73E;" FontSize="26" Foreground="{StaticResource SuccessColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            </Border>

                            <TextBlock Text="{x:Bind Loc.WingetNoUpdates, Mode=OneWay}" Style="{StaticResource EmptyStateTitleStyle}"/>

                            <TextBlock Text="{x:Bind Loc.NoUpdatesSubtitle, Mode=OneWay}" Style="{StaticResource EmptyStateSubtitleStyle}"/>

                            <Button Command="{x:Bind ViewModel.ScanWingetCommand}"

                                    Padding="16,8" CornerRadius="8" HorizontalAlignment="Center"

                                    Background="{StaticResource AccentSubtleBrush}" BorderThickness="1" BorderBrush="{StaticResource AccentPillBorderBrush}">

                                <StackPanel Orientation="Horizontal" Spacing="6">

                                    <FontIcon Glyph="&#xE895;" FontSize="12" Foreground="{StaticResource AccentBrush}"/>

                                    <TextBlock Text="{x:Bind Loc.WingetScan, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>

                                </StackPanel>

                            </Button>

                        </StackPanel>

                    </Border>

                    <!-- Status bar -->

                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Opacity="0.7" />

                    <!-- W2: Install from winget (search + card list, ZuiV2 section pattern) -->

                    <StackPanel Spacing="8" Margin="0,16,0,0">

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0">

                            <FontIcon Glyph="&#xE721;" FontSize="14" Foreground="{StaticResource AccentBrush}"/>

                            <TextBlock Text="{x:Bind Loc.WingetSearchSection, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"

                                       Foreground="{StaticResource TextSecondaryBrush}" CharacterSpacing="40"/>

                        </StackPanel>

                        <!-- Search row -->

                        <Grid ColumnSpacing="8" Background="{StaticResource CardBackgroundBrush}"

                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"

                              CornerRadius="8" Padding="12">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*" />

                                <ColumnDefinition Width="Auto" />

                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Text="{x:Bind ViewModel.WingetSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"

                                     PlaceholderText="{x:Bind Loc.WingetSearchPlaceholder, Mode=OneWay}"

                                     Background="Transparent" BorderThickness="0" CornerRadius="8" VerticalAlignment="Center"/>

                            <Button Grid.Column="1" Command="{x:Bind ViewModel.SearchWingetCommand}"

                                    Style="{StaticResource AccentButtonStyle}" Padding="16,8" CornerRadius="8"

                                    IsEnabled="{x:Bind ViewModel.IsWingetSearching, Converter={StaticResource InverseBool}, Mode=OneWay}">

                                <StackPanel Orientation="Horizontal" Spacing="6">

                                    <FontIcon Glyph="&#xE721;" FontSize="12"/>

                                    <TextBlock Text="{x:Bind Loc.WingetSearch, Mode=OneWay}"/>

                                </StackPanel>

                            </Button>

                        </Grid>

                        <!-- Searching progress -->

                        <ProgressBar Visibility="{x:Bind ViewModel.IsWingetSearching, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"

                                     IsIndeterminate="True" CornerRadius="3"/>

                        <!-- Results -->

                        <ListView ItemsSource="{x:Bind ViewModel.WingetSearchResults, Mode=OneWay}" SelectionMode="None">

                            <ListView.ItemTemplate>

                                <DataTemplate x:DataType="vm:WingetSearchItem">

                                    <Grid Padding="12" ColumnSpacing="12" Margin="0,0,0,8"

                                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"

                                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"

                                          BorderThickness="1" CornerRadius="10">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="Auto" />

                                            <ColumnDefinition Width="2*" />

                                            <ColumnDefinition Width="1*" />

                                            <ColumnDefinition Width="Auto" />

                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"

                                                Background="{StaticResource HeroOverlayBrush}" VerticalAlignment="Center">

                                            <TextBlock Text="{x:Bind Monogram}" HorizontalAlignment="Center" VerticalAlignment="Center"

                                                       FontSize="13" FontWeight="SemiBold"/>

                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">

                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/>

                                            <TextBlock Text="{x:Bind Id}" Opacity="0.6" FontSize="11"/>

                                            <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" FontSize="11"

                                                       Foreground="{StaticResource AccentBrush}"/>

                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">

                                            <TextBlock Text="{x:Bind Version}" Opacity="0.8" HorizontalAlignment="Right"/>

                                            <TextBlock Text="{x:Bind Source}" Opacity="0.5" FontSize="11" HorizontalAlignment="Right"/>

                                        </StackPanel>

                                        <Button Grid.Column="3" Command="{x:Bind InstallWingetCommand}" CommandParameter="{x:Bind}"

                                                VerticalAlignment="Center" Padding="12,6" CornerRadius="8"

                                                Background="{StaticResource HeroOverlayBrush}" BorderThickness="0"

                                                IsEnabled="{x:Bind CanInstall, Mode=OneWay}">

                                            <StackPanel Orientation="Horizontal" Spacing="6">

                                                <FontIcon Glyph="&#xE896;" FontSize="12" Foreground="{StaticResource HeroTertiaryBrush}"/>

                                                <TextBlock Text="{x:Bind BtnInstall}" FontSize="11" Foreground="{StaticResource HeroTertiaryBrush}"/>

                                            </StackPanel>

                                        </Button>

                                    </Grid>

                                </DataTemplate>

                            </ListView.ItemTemplate>

                        </ListView>

                        <!-- No results after search -->

                        <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="8" Padding="16"

                                Visibility="{x:Bind ViewModel.WingetSearchNoResults, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">

                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">

                                <FontIcon Glyph="&#xE721;" FontSize="14" Foreground="{StaticResource AccentBrush}"/>

                                <TextBlock Text="{x:Bind Loc.WingetSearchNoResults, Mode=OneWay}" FontSize="12"

                                           Foreground="{StaticResource TextSecondaryBrush}"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </StackPanel>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Page>

