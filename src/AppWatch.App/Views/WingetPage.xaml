<Page
    x:Class="AppWatch.Views.WingetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AppWatch.ViewModels"
    Background="Transparent"
    NavigationCacheMode="Required">

    <Grid Padding="32,24" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header with back button (ZuiV2 pattern) -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
            <Button Click="Back_Click" Padding="8" CornerRadius="6" Background="Transparent" BorderThickness="0">
                <FontIcon Glyph="&#xE72B;" FontSize="14"/>
            </Button>
            <StackPanel Spacing="4">
                <TextBlock Text="{x:Bind Loc.WingetUpdates, Mode=OneWay}" Style="{StaticResource PageHeaderStyle}" />
                <TextBlock Text="{x:Bind Loc.WingetPageSubtitle, Mode=OneWay}" Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16">

                <!-- Winget Hero Banner (ZuiV2 ZapretHeroBorder pattern) -->
                <Border Style="{StaticResource WingetHeroBorder}">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto">
                        <!-- Left: Title + Metrics -->
                        <StackPanel Grid.Column="0" Grid.Row="0" Spacing="12">
                            <!-- Title row -->
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE753;" FontSize="28" Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind Loc.WingetUpdates, Mode=OneWay}" FontSize="28" FontWeight="SemiBold"
                                           Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Metrics row -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Background="{StaticResource HeroOverlayBrush}" CornerRadius="10" Padding="16,12" MinWidth="120">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{x:Bind Loc.WingetMetricTotal, Mode=OneWay}" FontSize="11" Foreground="{StaticResource HeroSecondaryBrush}"/>
                                        <TextBlock Text="{x:Bind ViewModel.WingetTotalCount, Mode=OneWay}"
                                                   FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource HeroOverlayBrush}" CornerRadius="10" Padding="16,12" MinWidth="100">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{x:Bind Loc.WingetMetricUpdates, Mode=OneWay}" FontSize="11" Foreground="{StaticResource HeroSecondaryBrush}"/>
                                        <TextBlock Text="{x:Bind ViewModel.WingetUpdatesAvailable, Mode=OneWay}"
                                                   FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource HeroOverlayBrush}" CornerRadius="10" Padding="16,12" MinWidth="90">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{x:Bind Loc.WingetMetricPending, Mode=OneWay}" FontSize="11" Foreground="{StaticResource HeroSecondaryBrush}"/>
                                        <TextBlock Text="{x:Bind ViewModel.WingetPendingUpdates, Mode=OneWay}"
                                                   FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Right: Actions -->
                        <StackPanel Grid.Column="1" Grid.Row="0" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Command="{x:Bind ViewModel.ScanWingetCommand}"
                                    ToolTipService.ToolTip="{x:Bind Loc.WingetScan, Mode=OneWay}"
                                    Padding="12,6" CornerRadius="6"
                                    Background="{StaticResource HeroOverlayBrush}" BorderThickness="0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE895;" FontSize="14" Foreground="{StaticResource HeroTertiaryBrush}"/>
                                    <TextBlock Text="{x:Bind Loc.WingetScan, Mode=OneWay}"
                                               FontSize="13" Foreground="{StaticResource HeroTertiaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind ViewModel.UpdateSelectedWingetCommand}"
                                    ToolTipService.ToolTip="{x:Bind Loc.WingetUpdateSelected, Mode=OneWay}"
                                    Padding="12,6" CornerRadius="6"
                                    Background="{StaticResource HeroOverlayBrush}" BorderThickness="0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE753;" FontSize="14" Foreground="{StaticResource HeroTertiaryBrush}"/>
                                    <TextBlock Text="{x:Bind Loc.WingetUpdateSelected, Mode=OneWay}"
                                               FontSize="13" Foreground="{StaticResource HeroTertiaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Winget Updates List (ZuiV2 card rows with checkboxes) -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0">
                        <FontIcon Glyph="&#xE753;" FontSize="14" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="{x:Bind Loc.WingetUpdates, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" CharacterSpacing="40"/>
                    </StackPanel>

                    <ListView ItemsSource="{x:Bind ViewModel.WingetUpdates, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:WingetItem">
                                <Grid Padding="12" ColumnSpacing="12" Margin="0,0,0,8"
                                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                      BorderThickness="1" CornerRadius="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Status, Mode=OneWay}" Opacity="0.7" FontSize="12" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind Versions}" VerticalAlignment="Center" Opacity="0.8" />
                                    <ProgressBar Grid.Column="3" VerticalAlignment="Center"
                                                 Visibility="{x:Bind IsUpdating, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                                 IsIndeterminate="False"
                                                 Value="{x:Bind ProgressValue, Mode=OneWay}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Status bar -->
                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Opacity="0.7" />

                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
