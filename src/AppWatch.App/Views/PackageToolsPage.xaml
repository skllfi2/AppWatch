<Page
    x:Class="AppWatch.Views.PackageToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AppWatch.ViewModels"
    Background="Transparent"
    NavigationCacheMode="Required">

    <Grid Padding="32,24" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="{x:Bind Loc.NavPackageTools, Mode=OneWay}" Style="{StaticResource PageHeaderStyle}" />
            <TextBlock Text="{x:Bind Loc.PackageToolsPageSubtitle, Mode=OneWay}" Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16">

                <!-- Toolbar & Actions -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Filter ComboBox -->
                    <ComboBox Grid.Column="0" MinWidth="160" VerticalAlignment="Center"
                              SelectedIndex="{x:Bind ViewModel.SelectedFilterIndex, Mode=TwoWay}"
                              CornerRadius="8" Background="{StaticResource CardBackgroundBrush}">
                        <ComboBoxItem Content="{x:Bind Loc.FilterAll, Mode=OneWay}" />
                        <ComboBoxItem Content="Node.js (npm)" />
                        <ComboBoxItem Content="Bun" />
                        <ComboBoxItem Content=".NET Tools" />
                        <ComboBoxItem Content="Rust (cargo)" />
                        <ComboBoxItem Content="Scoop" />
                        <ComboBoxItem Content="Chocolatey" />
                    </ComboBox>

                    <!-- Select all -->
                    <Button Grid.Column="1" Command="{x:Bind ViewModel.SelectAllCommand}"
                            Padding="10,6" CornerRadius="8" Background="{StaticResource CardBackgroundBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8B3;" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="{x:Bind Loc.WingetSelectAll, Mode=OneWay}" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <!-- Deselect all -->
                    <Button Grid.Column="2" Command="{x:Bind ViewModel.DeselectAllCommand}"
                            Padding="10,6" CornerRadius="8" Background="{StaticResource CardBackgroundBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8E6;" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="{x:Bind Loc.WingetDeselectAll, Mode=OneWay}" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <!-- Rescan -->
                    <Button Grid.Column="3" Command="{x:Bind ViewModel.ScanCommand}"
                            Padding="12,6" CornerRadius="8" Background="{StaticResource CardBackgroundBrush}" BorderThickness="1"
                            IsEnabled="{x:Bind ViewModel.IsScanning, Converter={StaticResource InverseBool}, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="{x:Bind Loc.QuickCheck, Mode=OneWay}" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <!-- Update Selected -->
                    <Button Grid.Column="4" Command="{x:Bind ViewModel.UpdateSelectedCommand}"
                            Style="{StaticResource AccentButtonStyle}" Padding="14,6" CornerRadius="8"
                            IsEnabled="{x:Bind ViewModel.IsUpdatingAny, Converter={StaticResource InverseBool}, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE896;" FontSize="12"/>
                            <TextBlock Text="{x:Bind Loc.BtnUpdateSelected, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Scanning progress bar -->
                <ProgressBar IsIndeterminate="True" Height="4" CornerRadius="2"
                             Visibility="{x:Bind ViewModel.IsScanning, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />

                <!-- Empty State -->
                <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="10" Padding="32,24"
                        BorderThickness="1" BorderBrush="{StaticResource BorderDefaultBrush}"
                        Visibility="{x:Bind ViewModel.FilteredTools.Count, Converter={StaticResource InverseCountToVisibility}, Mode=OneWay}">
                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE756;" FontSize="32" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{x:Bind Loc.PackageToolsEmpty, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{x:Bind Loc.PackageToolsEmptyHint, Mode=OneWay}" FontSize="12" Opacity="0.7" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                        <Button Command="{x:Bind ViewModel.ScanCommand}" Content="{x:Bind Loc.QuickCheck, Mode=OneWay}"
                                HorizontalAlignment="Center" Padding="14,6" CornerRadius="6" Style="{StaticResource AccentButtonStyle}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Tools List -->
                <ItemsControl ItemsSource="{x:Bind ViewModel.FilteredTools, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PackageToolItem">
                            <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="10" Padding="14,12"
                                    BorderThickness="1" BorderBrush="{StaticResource BorderDefaultBrush}" Margin="0,0,0,8">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Checkbox for updating -->
                                    <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Center" MinWidth="0" Padding="0"/>

                                    <!-- Package info -->
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <!-- Manager badge -->
                                            <Border Background="{x:Bind RunnerBrush}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind RunnerBadge}" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{x:Bind Description, Mode=OneWay}" FontSize="12" Opacity="0.7"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>

                                    <!-- Versions column: 130px like TrackedAppsPage -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <Border Background="{StaticResource NeutralSubtleBrush}" BorderBrush="{StaticResource NeutralPillBorderBrush}"
                                                BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind CurrentVersion}" FontSize="11" Opacity="0.8"/>
                                        </Border>

                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                                    Visibility="{x:Bind HasUpdate, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                            <TextBlock Text="→" FontSize="11" Opacity="0.5" VerticalAlignment="Center"/>
                                            <Border Background="{StaticResource AccentSubtleBrush}" BorderBrush="{StaticResource AccentPillBorderBrush}"
                                                    BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind AvailableVersion}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Updating progress ring -->
                                    <ProgressRing Grid.Column="3" IsActive="{x:Bind IsUpdating, Mode=OneWay}"
                                                  Width="20" Height="20" VerticalAlignment="Center"
                                                  Visibility="{x:Bind IsUpdating, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Install Global Package Section (Unified bottom bar like WingetPage) -->
                <StackPanel Spacing="8" Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0">
                        <FontIcon Glyph="&#xE896;" FontSize="14" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="{x:Bind Loc.InstallGlobalPackageTitle, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" CharacterSpacing="40"/>
                    </StackPanel>

                    <Grid Padding="12" ColumnSpacing="10"
                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="1" CornerRadius="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Package Manager selector -->
                        <ComboBox Grid.Column="0" SelectedIndex="{x:Bind ViewModel.SelectedInstallManagerIndex, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Center" CornerRadius="8" Background="{StaticResource CardBackgroundBrush}">
                            <ComboBoxItem Content="Node.js (npm)" />
                            <ComboBoxItem Content="Bun" />
                            <ComboBoxItem Content=".NET Tool" />
                            <ComboBoxItem Content="Rust (cargo)" />
                            <ComboBoxItem Content="Scoop" />
                            <ComboBoxItem Content="Chocolatey" />
                        </ComboBox>

                        <!-- Package name input -->
                        <TextBox Grid.Column="1" Text="{x:Bind ViewModel.NewPackageName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="{x:Bind Loc.InstallGlobalPackagePlaceholder, Mode=OneWay}"
                                 Background="Transparent" BorderThickness="0" CornerRadius="8" VerticalAlignment="Center"/>

                        <!-- Install button -->
                        <Button Grid.Column="2" Command="{x:Bind ViewModel.InstallPackageCommand}"
                                Style="{StaticResource AccentButtonStyle}" Padding="16,8" CornerRadius="8"
                                IsEnabled="{x:Bind ViewModel.IsInstallingPackage, Converter={StaticResource InverseBool}, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ProgressRing IsActive="{x:Bind ViewModel.IsInstallingPackage, Mode=OneWay}" Width="12" Height="12"
                                              Visibility="{x:Bind ViewModel.IsInstallingPackage, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"/>
                                <FontIcon Glyph="&#xE896;" FontSize="12"
                                          Visibility="{x:Bind ViewModel.IsInstallingPackage, Converter={StaticResource InverseBoolToVisibility}, Mode=OneWay}"/>
                                <TextBlock Text="{x:Bind Loc.BtnInstallPackage, Mode=OneWay}"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Install status message -->
                    <TextBlock Text="{x:Bind ViewModel.InstallMessage, Mode=OneWay}"
                               FontSize="12" Foreground="{StaticResource AccentBrush}" Margin="8,2,0,0"
                               Visibility="{x:Bind ViewModel.InstallMessage, Converter={StaticResource StringNotEmptyToVisibility}, Mode=OneWay}"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
