<Page
    x:Class="AppWatch.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    NavigationCacheMode="Required">

    <Grid Padding="32,24" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,20">
            <StackPanel Spacing="4">
                <TextBlock Text="{x:Bind Loc.AboutPageTitle, Mode=OneWay}" FontSize="28" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="{x:Bind Loc.AboutPageSubtitle, Mode=OneWay}" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="24" MaxWidth="800" HorizontalAlignment="Left" Padding="0,0,16,24">

                <!-- 1. Hero Identity Card (Windows 11 Fluent App Profile) -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="24">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- App Icon Badge -->
                        <Border Grid.Column="0" Width="64" Height="64" CornerRadius="14"
                                Background="{StaticResource AccentBrush}" VerticalAlignment="Top">
                            <FontIcon Glyph="&#xE8B9;" FontSize="32" Foreground="White"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Title, Version, Tagline -->
                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="AppWatch" FontSize="22" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <Border Background="{StaticResource AccentSubtleBrush}"
                                        BorderBrush="{StaticResource AccentPillBorderBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind AppVersion}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{x:Bind Loc.AboutHeroDescription, Mode=OneWay}"
                                       FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" LineHeight="19" />
                        </StackPanel>

                        <!-- Check updates button -->
                        <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}"
                                VerticalAlignment="Center" Padding="14,8"
                                Click="CheckAppWatchUpdate_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE895;" FontSize="13" />
                                <TextBlock Text="{x:Bind Loc.AboutCheckUpdates, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- 2. System and Environment Info Section -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0">
                        <FontIcon Glyph="&#xE7F8;" FontSize="14" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="{x:Bind Loc.AboutSystemInfo, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" CharacterSpacing="40"/>
                    </StackPanel>

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16,12">
                        <Grid ColumnSpacing="16" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- OS -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Операционная система" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind OsVersion}" FontSize="12"
                                       FontWeight="Medium" VerticalAlignment="Center" />

                            <!-- Framework -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Среда выполнения" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind FrameworkVersion}" FontSize="12"
                                       FontWeight="Medium" VerticalAlignment="Center" />

                            <!-- Architecture -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Архитектура" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ProcessArchitecture}" FontSize="12"
                                       FontWeight="Medium" VerticalAlignment="Center" />

                            <!-- Copy info button -->
                            <Button x:Name="CopyBtn" Grid.Row="0" Grid.RowSpan="3" Grid.Column="2"
                                    VerticalAlignment="Center" Padding="12,6" CornerRadius="6"
                                    Background="{StaticResource CardBackgroundBrush}" BorderThickness="1"
                                    BorderBrush="{StaticResource BorderDefaultBrush}"
                                    Click="CopySystemInfo_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock Text="{x:Bind Loc.AboutCopySystemInfo, Mode=OneWay}" FontSize="11"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 3. Links & Community Resources Section -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0">
                        <FontIcon Glyph="&#xE71B;" FontSize="14" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="{x:Bind Loc.AboutLinks, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" CharacterSpacing="40"/>
                    </StackPanel>

                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- GitHub Repo -->
                        <Border Grid.Row="0" Grid.Column="0"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14,10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE774;" FontSize="18" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind Loc.AboutRepo, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                                    <HyperlinkButton NavigateUri="https://github.com/skllfi2/AppWatch" Padding="0"
                                                     Content="github.com/skllfi2/AppWatch" FontSize="11" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Release Notes -->
                        <Border Grid.Row="0" Grid.Column="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14,10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE7BA;" FontSize="18" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind Loc.AboutReleaseNotes, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                                    <HyperlinkButton NavigateUri="https://github.com/skllfi2/AppWatch/releases" Padding="0"
                                                     Content="Список релизов на GitHub" FontSize="11" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Report Issue -->
                        <Border Grid.Row="1" Grid.Column="0"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14,10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE730;" FontSize="18" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind Loc.AboutReportIssue, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                                    <HyperlinkButton NavigateUri="https://github.com/skllfi2/AppWatch/issues" Padding="0"
                                                     Content="Трекер ошибок и багов" FontSize="11" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Feature Request -->
                        <Border Grid.Row="1" Grid.Column="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14,10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE785;" FontSize="18" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind Loc.AboutRequestFeature, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                                    <HyperlinkButton NavigateUri="https://github.com/skllfi2/AppWatch/discussions" Padding="0"
                                                     Content="Идеи и обсуждения сообщества" FontSize="11" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- 4. Architecture & Attributions Section -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0">
                        <FontIcon Glyph="&#xE943;" FontSize="14" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="{x:Bind Loc.AboutAttribution, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" CharacterSpacing="40"/>
                    </StackPanel>

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="3">
                                <TextBlock Text="UniGetUI (MIT License)" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="Идеи и UX-паттерны агрегации сторонних пакетных менеджеров и каталогов обновлений Windows."
                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <MenuFlyoutSeparator Margin="0,2"/>
                            <StackPanel Spacing="3">
                                <TextBlock Text="komi-store (Apache-2.0 License)" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="Подходы к бесшовному обновлению и изоляции портативных приложений без прав администратора."
                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <MenuFlyoutSeparator Margin="0,2"/>
                            <StackPanel Spacing="3">
                                <TextBlock Text="WinUI 3 &amp; Windows App SDK" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="Современный пользовательский интерфейс Microsoft Fluent Design, Mica backdrop и аппаратное ускорение."
                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <MenuFlyoutSeparator Margin="0,2"/>
                            <StackPanel Spacing="3">
                                <TextBlock Text="Rust Native Bridge (cdylib)" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="Высокопроизводительное системное ядро сканирования каталогов, хеширования и потокового декомпрессирования."
                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 5. Legal & Disclaimer -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0">
                        <FontIcon Glyph="&#xE8D7;" FontSize="14" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="{x:Bind Loc.AboutLicense, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" CharacterSpacing="40"/>
                    </StackPanel>

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind Loc.AboutLicenseType, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind Loc.AboutDisclaimerText, Mode=OneWay}"
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- TeachingTip toast notification upon copying info -->
        <TeachingTip x:Name="CopiedTeachingTip"
                     Title="{x:Bind Loc.AboutSystemInfoCopied, Mode=OneWay}"
                     Target="{x:Bind CopyBtn}"
                     PreferredPlacement="Bottom"
                     IsLightDismissEnabled="True"/>
    </Grid>
</Page>
