<Page
    x:Class="AppWatch.Views.HomeCatalogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AppWatch.ViewModels"
    xmlns:core="using:AppWatch.Core.Domain.Models"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <conv:StageToVisConverter x:Key="StageToVis" xmlns:conv="using:AppWatch.Converters" />
        <conv:FirstCharToBrushConverter x:Key="FirstCharToBrush" xmlns:conv="using:AppWatch.Converters" />
        <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibility" xmlns:conv="using:AppWatch.Converters" />
        <conv:InverseCountToVisibilityConverter x:Key="InverseCountToVisibility" xmlns:conv="using:AppWatch.Converters" />

        <!-- AppCardTemplate from AppsPage -->
        <DataTemplate x:Key="AppCardTemplate" x:DataType="vm:TrackedAppItem">
            <Grid Padding="12" ColumnSpacing="12" Margin="0,0,0,8"
                  Background="{StaticResource CardBackgroundBrush}" CornerRadius="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Command="{x:Bind ShowDetailsCommand}" CommandParameter="{x:Bind}"
                        AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind StatusTooltip, Mode=OneWay}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Background="Transparent" BorderThickness="0" Padding="4,4,8,4"
                        CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="36" Height="36" CornerRadius="6"
                                Background="{x:Bind MonogramBrush}" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Monogram}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Ellipse Width="9" Height="9" Fill="{x:Bind StatusBrush, Mode=OneWay}" VerticalAlignment="Center"
                                         ToolTipService.ToolTip="{x:Bind StatusTooltip, Mode=OneWay}"/>
                                <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" FontSize="11" Opacity="0.75"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind Version, Mode=OneWay}" FontSize="11" Opacity="0.55"
                                           VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                            Visibility="{x:Bind UpdateAvailable, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                    <TextBlock Text="→" FontSize="11" Opacity="0.55" VerticalAlignment="Center"/>
                                    <TextBlock Text="{x:Bind LatestTag, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{x:Bind LastCheckText, Mode=OneWay}" FontSize="10" Opacity="0.4"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    </Button>

                <ProgressBar Grid.Column="1" VerticalAlignment="Center" Width="110" Height="6"
                             Minimum="0" Maximum="100"
                             Value="{x:Bind ProgressValue, Mode=OneWay}"
                             Visibility="{x:Bind Stage, Converter={StaticResource StageToVis}, Mode=OneWay}"
                             IsIndeterminate="False"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Command="{x:Bind UpdateOneCommand}" CommandParameter="{x:Bind}"
                            AutomationProperties.Name="{x:Bind BtnUpdateOne, Mode=OneWay}"
                            Visibility="{x:Bind UpdateAvailable, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                            Padding="12,6" CornerRadius="6"
                            Background="{StaticResource HeroOverlayBrush}" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE896;" FontSize="12" Foreground="{StaticResource HeroTertiaryBrush}"/>
                            <TextBlock Text="{x:Bind BtnUpdateOne}" FontSize="11" Foreground="{StaticResource HeroTertiaryBrush}"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind LaunchAppCommand}" CommandParameter="{x:Bind}"
                            AutomationProperties.Name="{x:Bind BtnLaunch, Mode=OneWay}"
                            Visibility="{x:Bind CanLaunchPrimary, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                            Padding="12,6" CornerRadius="6"
                            Background="{StaticResource HeroOverlayBrush}" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE768;" FontSize="12" Foreground="{StaticResource HeroTertiaryBrush}"/>
                            <TextBlock Text="{x:Bind BtnLaunch}" FontSize="11" Foreground="{StaticResource HeroTertiaryBrush}"/>
                        </StackPanel>
                    </Button>
                    <Button Padding="8,6" CornerRadius="6"
                            AutomationProperties.Name="{x:Bind MenuEdit, Mode=OneWay}"
                            Background="{StaticResource HeroOverlayBrush}" BorderThickness="0"
                            ToolTipService.ToolTip="{x:Bind MenuEdit, Mode=OneWay}">
                        <FontIcon Glyph="&#xE10C;" FontSize="12" Foreground="{StaticResource HeroTertiaryBrush}" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Command="{x:Bind SkipVersionCommand}" CommandParameter="{x:Bind}"
                                                Text="{x:Bind MenuSkipVersion, Mode=OneWay}"
                                                Visibility="{x:Bind UpdateAvailable, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE7E3;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Command="{x:Bind PinCurrentCommand}" CommandParameter="{x:Bind}"
                                                Text="{x:Bind MenuPinCurrent, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE840;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Command="{x:Bind RollbackAppCommand}" CommandParameter="{x:Bind}"
                                                Text="{x:Bind BtnRollback, Mode=OneWay}"
                                                Visibility="{x:Bind RollbackAvailable, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE7A6;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Command="{x:Bind EditAppCommand}" CommandParameter="{x:Bind}"
                                                Text="{x:Bind MenuEdit, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE70F;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Command="{x:Bind ResetRulesCommand}" CommandParameter="{x:Bind}"
                                                Text="{x:Bind MenuResetRules, Mode=OneWay}"
                                                Visibility="{x:Bind RuleBadge, Converter={StaticResource StringNotEmptyToVisibility}, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE74D;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Command="{x:Bind UninstallAppCommand}" CommandParameter="{x:Bind}"
                                                Text="{x:Bind MenuUninstall, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE74D;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- CatalogItem template from CatalogPage -->
        <DataTemplate x:Key="CatalogItemTemplate" x:DataType="vm:CatalogItem">
            <Grid Padding="16" ColumnSpacing="16" Margin="0,0,0,8"
                  Background="{StaticResource CardBackgroundBrush}" CornerRadius="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="6"
                        Background="{x:Bind MonogramBrush}" VerticalAlignment="Center"
                        Margin="0,0,12,0">
                    <TextBlock Text="{x:Bind Monogram}" FontSize="16" FontWeight="SemiBold"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="10" Height="10" Fill="{x:Bind StatusBrush}" VerticalAlignment="Center"
                                 ToolTipService.ToolTip="{x:Bind StatusTooltip}"/>
                        <TextBlock Text="{x:Bind Version}" Opacity="0.7" FontSize="12"/>
                        <TextBlock Text="{x:Bind StatusText}" Opacity="0.5" FontSize="12"
                                   TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Command="{x:Bind InstallCommand}" CommandParameter="{x:Bind}"
                            AutomationProperties.Name="{x:Bind Loc.WingetInstall, Mode=OneWay}"
                            Padding="12,6" CornerRadius="6" FontSize="12"
                            Background="{StaticResource CardBackgroundBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="{x:Bind Loc.WingetInstall, Mode=OneWay}" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" xmlns:conv="using:AppWatch.Converters" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" xmlns:conv="using:AppWatch.Converters" />
        <conv:CountToVisibilityConverter x:Key="CountToVisibility" xmlns:conv="using:AppWatch.Converters" />
    </Page.Resources>

    <Grid Padding="32,24" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Tabs -->
        <TabView Grid.Row="0" x:Name="Tabs" TabWidthMode="Equal" MinWidth="600"
                 SelectedIndex="{x:Bind ViewModel.SelectedTabIndex, Mode=TwoWay}"
                 Margin="0,0,0,16">
            <TabView.TabStripHeader>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0">
                    <FontIcon Glyph="&#xE896;" FontSize="14" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="{x:Bind Loc.TabHome, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" CharacterSpacing="40"/>
                </StackPanel>
            </TabView.TabStripHeader>
            <TabView.TabStripFooter>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0">
                    <FontIcon Glyph="&#xE8F1;" FontSize="14" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="{x:Bind Loc.TabCatalog, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" CharacterSpacing="40"/>
                </StackPanel>
            </TabView.TabStripFooter>

            <!-- Tab 1: Home -->
            <TabViewItem Header="{x:Bind Loc.TabHome, Mode=OneWay}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="16">

                        <!-- Compact dashboard toolbar: metrics + quick actions -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Metric chips (now buttons) -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Command="{x:Bind ViewModel.UpdateAllCommand}"
                                        AutomationProperties.Name="{x:Bind Loc.UpdateAll, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind Loc.UpdateAll, Mode=OneWay}"
                                        Padding="12,6" CornerRadius="6"
                                        Background="{StaticResource CardBackgroundBrush}" BorderThickness="1"
                                        Visibility="{x:Bind ViewModel.IsUpdateAllRunning, Converter={StaticResource InverseBoolToVisibility}, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE896;" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                                        <TextBlock Text="{x:Bind Loc.UpdateAll, Mode=OneWay}" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{x:Bind ViewModel.StopUpdateAllCommand}"
                                        AutomationProperties.Name="{x:Bind Loc.BtnStop, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind Loc.BtnStop, Mode=OneWay}"
                                        Padding="12,6" CornerRadius="6"
                                        Background="#26D83B01" BorderThickness="1"
                                        Visibility="{x:Bind ViewModel.IsUpdateAllRunning, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="#FFD83B01"/>
                                        <TextBlock Text="{x:Bind Loc.BtnStop, Mode=OneWay}" FontSize="12" Foreground="#FFD83B01"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{x:Bind ViewModel.AddCustomAppCommand}"
                                        AutomationProperties.Name="{x:Bind Loc.AddApp, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind Loc.AddApp, Mode=OneWay}"
                                        Padding="12,6" CornerRadius="6"
                                        Background="{StaticResource CardBackgroundBrush}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE710;" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                                        <TextBlock Text="{x:Bind Loc.AddApp, Mode=OneWay}" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                    <!-- Metric chips (informational) -->
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="6" Padding="12,6"
                                BorderThickness="1" BorderBrush="{StaticResource BorderDefaultBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="8" Height="8" Fill="{x:Bind ViewModel.StatusDotBrush, Mode=OneWay}" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind Loc.HeroMetricTracked, Mode=OneWay}" FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind ViewModel.AppsTrackedCount, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="6" Padding="12,6"
                                BorderThickness="1" BorderBrush="{StaticResource BorderDefaultBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74A;" FontSize="11" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind Loc.HeroMetricUpdates, Mode=OneWay}" FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind ViewModel.UpdatesAvailableCount, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="6" Padding="12,6"
                                BorderThickness="1" BorderBrush="{StaticResource BorderDefaultBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind Loc.HeroMetricUpdatedToday, Mode=OneWay}" FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind ViewModel.UpdatedTodayCount, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="6" Padding="12,6"
                                BorderThickness="1" BorderBrush="{StaticResource BorderDefaultBrush}"
                                Visibility="{x:Bind ViewModel.NextCheckText, Converter={StaticResource StringNotEmptyToVisibility}, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE823;" FontSize="11" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind ViewModel.NextCheckText, Mode=OneWay}" FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Home groups (Updates / Errors / UpToDate / Disabled) -->
                <StackPanel Spacing="16">

                    <!-- Updates available -->
                    <StackPanel Spacing="8"
                                Visibility="{x:Bind ViewModel.HasUpdates, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE896;" FontSize="14" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="{x:Bind ViewModel.UpdatesHeaderText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}" CharacterSpacing="40"/>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{x:Bind ViewModel.UpdateAllCommand}"
                                    AutomationProperties.Name="{x:Bind Loc.UpdateAll, Mode=OneWay}"
                                    Padding="12,6" CornerRadius="6"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Visibility="{x:Bind ViewModel.IsUpdateAllRunning, Converter={StaticResource InverseBoolToVisibility}, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE896;" FontSize="12"/>
                                    <TextBlock Text="{x:Bind Loc.UpdateAll, Mode=OneWay}" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <ListView ItemsSource="{x:Bind ViewModel.UpdatesGroup, Mode=OneWay}" SelectionMode="None"
                                  ItemTemplate="{StaticResource AppCardTemplate}"/>
                    </StackPanel>

                    <!-- Errors -->
                    <StackPanel Spacing="8"
                                Visibility="{x:Bind ViewModel.HasErrors, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0">
                            <FontIcon Glyph="&#xE783;" FontSize="14" Foreground="#FFD83B01"/>
                            <TextBlock Text="{x:Bind ViewModel.ErrorsHeaderText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}" CharacterSpacing="40"/>
                        </StackPanel>
                        <ListView ItemsSource="{x:Bind ViewModel.ErrorsGroup, Mode=OneWay}" SelectionMode="None"
                                  ItemTemplate="{StaticResource AppCardTemplate}"/>
                    </StackPanel>

                    <!-- Up to date -->
                    <StackPanel Spacing="8"
                                Visibility="{x:Bind ViewModel.HasUpToDate, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0">
                            <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.UpToDateHeaderText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}" CharacterSpacing="40"/>
                        </StackPanel>
                        <ListView ItemsSource="{x:Bind ViewModel.UpToDateGroup, Mode=OneWay}" SelectionMode="None"
                                  ItemTemplate="{StaticResource AppCardTemplate}"/>
                    </StackPanel>

                    <!-- Disabled -->
                    <StackPanel Spacing="8"
                                Visibility="{x:Bind ViewModel.HasDisabled, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0">
                            <FontIcon Glyph="&#xE738;" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.DisabledHeaderText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}" CharacterSpacing="40"/>
                        </StackPanel>
                        <ListView ItemsSource="{x:Bind ViewModel.DisabledGroup, Mode=OneWay}" SelectionMode="None"
                                  ItemTemplate="{StaticResource AppCardTemplate}"/>
                    </StackPanel>

                </StackPanel>

                <!-- Empty state: no tracked apps at all -->
                <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="8" Padding="24"
                        Visibility="{x:Bind ViewModel.Apps.Count, Converter={StaticResource InverseCountToVisibility}, Mode=OneWay}">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE8F1;" FontSize="24" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{x:Bind Loc.NoTrackedApps, Mode=OneWay}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                            <Button Command="{x:Bind ViewModel.GoToCatalogCommand}"
                                    Content="{x:Bind Loc.BtnOpenCatalog, Mode=OneWay}"
                                    Padding="12,6" CornerRadius="6" FontSize="12"
                                    Background="{StaticResource AccentBrush}" BorderThickness="0" Foreground="White" />
                            <Button Command="{x:Bind ViewModel.AddCustomAppCommand}"
                                    Content="{x:Bind Loc.AddApp, Mode=OneWay}"
                                    Padding="12,6" CornerRadius="6" FontSize="12"
                                    Background="{StaticResource CardBackgroundBrush}" BorderThickness="1" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- Tab 2: Catalog -->
            <TabViewItem Header="{x:Bind Loc.TabCatalog, Mode=OneWay}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="16">

                        <!-- Search + actions + category row -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{x:Bind ViewModel.CatalogSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="{x:Bind Loc.CatalogSearchPlaceholder, Mode=OneWay}"
                                     Background="{StaticResource CardBackgroundBrush}" CornerRadius="6"
                                     BorderThickness="1" Padding="8,6" FontSize="13"/>
                            <Button Grid.Column="1" Command="{x:Bind ViewModel.AddToCatalogCommand}"
                                    AutomationProperties.Name="{x:Bind Loc.AddApp, Mode=OneWay}"
                                    Content="{x:Bind Loc.AddApp, Mode=OneWay}"
                                    Padding="12,6" CornerRadius="6" FontSize="12"
                                    Background="{StaticResource CardBackgroundBrush}" BorderThickness="1"/>
                            <Button Grid.Column="2" Command="{x:Bind ViewModel.ImportFromStarsCommand}"
                                    AutomationProperties.Name="{x:Bind Loc.ImportFromStarsTitle, Mode=OneWay}"
                                    Content="{x:Bind Loc.ImportFromStarsTitle, Mode=OneWay}"
                                    Padding="12,6" CornerRadius="6" FontSize="12"
                                    Background="{StaticResource CardBackgroundBrush}" BorderThickness="1"/>
                            <Button Grid.Column="3" Command="{x:Bind ViewModel.ClearMyCatalogCommand}"
                                    AutomationProperties.Name="{x:Bind Loc.BtnClearMyCatalog, Mode=OneWay}"
                                    ToolTipService.ToolTip="{x:Bind Loc.BtnClearMyCatalog, Mode=OneWay}"
                                    Padding="12,6" CornerRadius="6" FontSize="12"
                                    Background="{StaticResource CardBackgroundBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{x:Bind Loc.BtnClearMyCatalog, Mode=OneWay}" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <ComboBox Grid.Column="4" SelectedIndex="{x:Bind ViewModel.CatalogCategoryIndex, Mode=TwoWay}"
                                      MinWidth="150" VerticalAlignment="Center" Padding="8,4" FontSize="12">
                                <ComboBoxItem Content="{x:Bind Loc.CategoryAll, Mode=OneWay}" />
                                <ComboBoxItem Content="{x:Bind Loc.CategoryUtility, Mode=OneWay}" />
                                <ComboBoxItem Content="{x:Bind Loc.CategoryMedia, Mode=OneWay}" />
                                <ComboBoxItem Content="{x:Bind Loc.CategoryNetwork, Mode=OneWay}" />
                                <ComboBoxItem Content="{x:Bind Loc.CategorySecurity, Mode=OneWay}" />
                                <ComboBoxItem Content="{x:Bind Loc.CategoryProductivity, Mode=OneWay}" />
                                <ComboBoxItem Content="{x:Bind Loc.CategoryDevelopment, Mode=OneWay}" />
                            </ComboBox>
                        </Grid>

                        <!-- Sources section: collapsible -->
                        <Expander Header="{x:Bind Loc.SourcesSection, Mode=OneWay}"
                                  Margin="0,8,0,8" IsExpanded="False">
                            <StackPanel Spacing="8" Margin="0,4,0,8">

                                <!-- Source list -->
                                <ItemsControl ItemsSource="{x:Bind ViewModel.CatalogSources, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="core:CatalogSource">
                                            <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="8" Padding="12"
                                                    BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                                                    Margin="0,0,0,8">
                                                <Grid ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="{x:Bind Name}" FontSize="12" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{x:Bind Url}" FontSize="10" Opacity="0.6" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                                                  IsOn="{x:Bind Enabled, Mode=TwoWay}"
                                                                  OnContent="{x:Bind Loc.SourceEnabled, Mode=OneWay}"
                                                                  OffContent="{x:Bind Loc.SourceDisabled, Mode=OneWay}"/>
                                                    <Button Grid.Column="2" Command="{x:Bind ViewModel.RemoveCatalogSourceCommand}" CommandParameter="{x:Bind}"
                                                            Content="{x:Bind Loc.BtnRemoveSource, Mode=OneWay}"
                                                            Padding="12,6" CornerRadius="6" FontSize="12"
                                                            Background="{StaticResource CardBackgroundBrush}" BorderThickness="1"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Add source row -->
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{x:Bind ViewModel.NewSourceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="{x:Bind Loc.SourceNamePlaceholder, Mode=OneWay}"
                                             Width="160" CornerRadius="6" BorderThickness="1"
                                             Background="{StaticResource CardBackgroundBrush}" FontSize="12"/>
                                    <TextBox Grid.Column="1" Text="{x:Bind ViewModel.NewSourceUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="{x:Bind Loc.SourceUrlPlaceholder, Mode=OneWay}"
                                             CornerRadius="6" BorderThickness="1"
                                             Background="{StaticResource CardBackgroundBrush}" FontSize="12"/>
                                    <Button Grid.Column="2" Command="{x:Bind ViewModel.AddCatalogSourceCommand}"
                                            Content="{x:Bind Loc.BtnAddSource, Mode=OneWay}"
                                            Padding="12,6" CornerRadius="6" FontSize="12"
                                            Background="{StaticResource CardBackgroundBrush}" BorderThickness="1"/>
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <ListView ItemsSource="{x:Bind ViewModel.FilteredCatalogApps, Mode=OneWay}" SelectionMode="None"
                                  ItemTemplate="{StaticResource CatalogItemTemplate}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
        </TabView>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource CardBackgroundBrush}" CornerRadius="8" Padding="16,8"
                Margin="0,16,0,0">
            <TextBlock Text="{x:Bind ViewModel.FooterText, Mode=OneWay}" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</Page>