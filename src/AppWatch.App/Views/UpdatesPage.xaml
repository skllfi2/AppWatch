<Page
    x:Class="AppWatch.Views.UpdatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:AppWatch.ViewModels"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    Background="Transparent">
    <Page.Resources>
        <conv:StageToVisConverter x:Key="StageToVis" xmlns:conv="using:AppWatch.Converters" />
        <!-- Same card as the old Updates tab (HomeCatalogPage) -->
<DataTemplate x:Key="UpdatesPageAppCardTemplate" x:DataType="vm:TrackedAppItem">
            <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="10" Padding="14,12"
                    BorderThickness="1" BorderBrush="{StaticResource BorderDefaultBrush}" Margin="0,0,0,8">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Command="{x:Bind ShowDetailsCommand}" CommandParameter="{x:Bind}"
                            AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind StatusTooltip, Mode=OneWay}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Background="Transparent" BorderThickness="0" Padding="0"
                            CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <!-- Icon: Image (if loaded) or Monogram fallback -->
                            <Grid Width="42" Height="42" CornerRadius="8" VerticalAlignment="Center">
                                <Image Source="{x:Bind Icon, Mode=OneWay}"
                                       Stretch="UniformToFill"
                                       Visibility="{x:Bind Icon, Converter={StaticResource ObjectToVisibility}, Mode=OneWay}" />
                                <Border Background="{x:Bind MonogramBrush}" CornerRadius="8"
                                        Visibility="{x:Bind Icon, Converter={StaticResource NullToVisibility}, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind Monogram}" FontSize="16" FontWeight="SemiBold"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{x:Bind Description, Mode=OneWay}" FontSize="12" Opacity="0.7"
                                           TextTrimming="CharacterEllipsis" MaxLines="1"
                                           Visibility="{x:Bind HasDescription, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="{x:Bind StatusBrush, Mode=OneWay}" VerticalAlignment="Center"
                                             ToolTipService.ToolTip="{x:Bind StatusTooltip, Mode=OneWay}"/>
                                    <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" FontSize="11" Opacity="0.7"
                                               VerticalAlignment="Center"/>
                                    <!-- Version Transition Pills -->
                                    <Border Background="{StaticResource NeutralSubtleBrush}"
                                            BorderBrush="{StaticResource NeutralPillBorderBrush}"
                                            BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Version, Mode=OneWay}" FontSize="11" Opacity="0.75"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                                Visibility="{x:Bind UpdateAvailable, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                        <TextBlock Text="→" FontSize="11" Opacity="0.5" VerticalAlignment="Center"/>
                                        <Border Background="{StaticResource AccentSubtleBrush}"
                                                BorderBrush="{StaticResource AccentPillBorderBrush}"
                                                BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind LatestTag, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind LastCheckText, Mode=OneWay}" FontSize="10" Opacity="0.4"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <ProgressBar Grid.Column="1" VerticalAlignment="Center" Width="110" Height="6"
                                 Minimum="0" Maximum="100" CornerRadius="3"
                                 Value="{x:Bind ProgressValue, Mode=OneWay}"
                                 Visibility="{x:Bind Stage, Converter={StaticResource StageToVis}, Mode=OneWay}"
                                 IsIndeterminate="False"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Command="{x:Bind UpdateOneCommand}" CommandParameter="{x:Bind}"
                                AutomationProperties.Name="{x:Bind BtnUpdateOne, Mode=OneWay}"
                                Visibility="{x:Bind UpdateAvailable, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="12,6" FontSize="12">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE896;" FontSize="12"/>
                                <TextBlock Text="{x:Bind BtnUpdateOne}" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind LaunchAppCommand}" CommandParameter="{x:Bind}"
                                AutomationProperties.Name="{x:Bind BtnLaunch, Mode=OneWay}"
                                Visibility="{x:Bind CanLaunchPrimary, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                                Padding="12,6" CornerRadius="8" FontSize="12"
                                Background="{StaticResource CardBackgroundBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE768;" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="{x:Bind BtnLaunch}" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <Button Padding="8,6" CornerRadius="8"
                                AutomationProperties.Name="{x:Bind MenuEdit, Mode=OneWay}"
                                Background="{StaticResource CardBackgroundBrush}" BorderThickness="1"
                                ToolTipService.ToolTip="{x:Bind MenuEdit, Mode=OneWay}">
                            <FontIcon Glyph="&#xE10C;" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Command="{x:Bind SkipVersionCommand}" CommandParameter="{x:Bind}"
                                                    Text="{x:Bind MenuSkipVersion, Mode=OneWay}"
                                                    Visibility="{x:Bind UpdateAvailable, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE7E3;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Command="{x:Bind PinCurrentCommand}" CommandParameter="{x:Bind}"
                                                    Text="{x:Bind MenuPinCurrent, Mode=OneWay}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE840;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Command="{x:Bind RollbackAppCommand}" CommandParameter="{x:Bind}"
                                                    Text="{x:Bind BtnRollback, Mode=OneWay}"
                                                    Visibility="{x:Bind RollbackAvailable, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE7A6;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Command="{x:Bind EditAppCommand}" CommandParameter="{x:Bind}"
                                                    Text="{x:Bind MenuEdit, Mode=OneWay}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE70F;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Command="{x:Bind ResetRulesCommand}" CommandParameter="{x:Bind}"
                                                    Text="{x:Bind MenuResetRules, Mode=OneWay}"
                                                    Visibility="{x:Bind RuleBadge, Converter={StaticResource StringNotEmptyToVisibility}, Mode=OneWay}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE74D;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Command="{x:Bind UninstallAppCommand}" CommandParameter="{x:Bind}"
                                                    Text="{x:Bind MenuUninstall, Mode=OneWay}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE74D;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>
    <Grid Padding="32,24" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{x:Bind Loc.TabUpdates, Mode=OneWay}" Style="{StaticResource PageHeaderStyle}"/>
            <TextBlock Text="{x:Bind Loc.UpdatesPageSubtitle, Mode=OneWay}" Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap"/>
        </StackPanel>
        <!-- Toolbar: schedule chips + quick actions -->
        <Grid Grid.Row="1" ColumnSpacing="12" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- Secondary info: updated today + next check (auto-hidden when empty) -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Left">
                <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="6" Padding="12,6"
                        BorderThickness="1" BorderBrush="{StaticResource BorderDefaultBrush}"
                        Visibility="{x:Bind ViewModel.UpdatedTodayCount, Converter={StaticResource CountToVisibility}, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind Loc.HeroMetricUpdatedToday, Mode=OneWay}" FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind ViewModel.UpdatedTodayCount, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="6" Padding="12,6"
                        BorderThickness="1" BorderBrush="{StaticResource BorderDefaultBrush}"
                        Visibility="{x:Bind ViewModel.NextCheckText, Converter={StaticResource StringNotEmptyToVisibility}, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE823;" FontSize="11" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind ViewModel.NextCheckText, Mode=OneWay}" FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <!-- Quick actions -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Command="{x:Bind ViewModel.CheckUpdatesCommand}"
                        AutomationProperties.Name="{x:Bind Loc.QuickCheck, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind Loc.QuickCheck, Mode=OneWay}"
                        Padding="12,7" CornerRadius="8" FontSize="12"
                        Background="{StaticResource CardBackgroundBrush}" BorderThickness="1"
                        Visibility="{x:Bind ViewModel.IsUpdateAllRunning, Converter={StaticResource InverseBoolToVisibility}, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="{x:Bind Loc.QuickCheck, Mode=OneWay}" FontSize="12"/>
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.UpdateAllCommand}"
                        AutomationProperties.Name="{x:Bind Loc.UpdateAll, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind Loc.UpdateAll, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}"
                        Visibility="{x:Bind ViewModel.IsUpdateAllRunning, Converter={StaticResource InverseBoolToVisibility}, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE896;" FontSize="12"/>
                        <TextBlock Text="{x:Bind Loc.UpdateAll, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.StopUpdateAllCommand}"
                        AutomationProperties.Name="{x:Bind Loc.BtnStop, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind Loc.BtnStop, Mode=OneWay}"
                        Padding="12,7" CornerRadius="8" FontSize="12"
                        Background="{StaticResource CriticalSubtleBrush}" BorderBrush="{StaticResource CriticalPillBorderBrush}" BorderThickness="1"
                        Visibility="{x:Bind ViewModel.IsUpdateAllRunning, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{StaticResource ErrorColor}"/>
                        <TextBlock Text="{x:Bind Loc.BtnStop, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource ErrorColor}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        <!-- Updates list -->
        <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.UpdatesGroup, Mode=OneWay}" SelectionMode="None"
                  ItemTemplate="{StaticResource UpdatesPageAppCardTemplate}"/>
        <!-- Empty state: no updates available -->
        <Border Grid.Row="2" Background="{StaticResource CardBackgroundBrush}" CornerRadius="12" Padding="32,28"
                BorderThickness="1" BorderBrush="{StaticResource BorderDefaultBrush}"
                Visibility="{x:Bind ViewModel.HasUpdates, Converter={StaticResource InverseBoolToVisibility}, Mode=OneWay}"
                VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel Spacing="6" HorizontalAlignment="Center">
                <Border Style="{StaticResource EmptyStateCircleStyle}" Background="{StaticResource SuccessSubtleBrush}">
                    <FontIcon Glyph="&#xE73E;" FontSize="26" Foreground="{StaticResource SuccessColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{x:Bind Loc.NoUpdatesAvailable, Mode=OneWay}" Style="{StaticResource EmptyStateTitleStyle}"/>
                <TextBlock Text="{x:Bind Loc.NoUpdatesSubtitle, Mode=OneWay}" Style="{StaticResource EmptyStateSubtitleStyle}"/>
                <Button Command="{x:Bind ViewModel.CheckUpdatesCommand}"
                        Padding="16,8" CornerRadius="8" HorizontalAlignment="Center"
                        Background="{StaticResource AccentSubtleBrush}" BorderThickness="1" BorderBrush="{StaticResource AccentPillBorderBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="{x:Bind Loc.QuickCheck, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>
