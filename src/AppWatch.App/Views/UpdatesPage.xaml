<Page
    x:Class="AppWatch.Views.UpdatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:AppWatch.ViewModels"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    Background="Transparent">
    <Page.Resources>
        <conv:StageToVisConverter x:Key="StageToVis" xmlns:conv="using:AppWatch.Converters" />
        <!-- Same card as the old Updates tab (HomeCatalogPage) -->
        <DataTemplate x:Key="UpdatesPageAppCardTemplate" x:DataType="vm:TrackedAppItem">
            <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="10" Padding="14,12"
                    BorderThickness="1" BorderBrush="{StaticResource BorderDefaultBrush}" Margin="0,0,0,8">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Command="{x:Bind ShowDetailsCommand}" CommandParameter="{x:Bind}"
                            AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind StatusTooltip, Mode=OneWay}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Background="Transparent" BorderThickness="0" Padding="0"
                            CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <!-- Icon: Image (if loaded) or Monogram fallback -->
                            <Grid Width="42" Height="42" CornerRadius="8" VerticalAlignment="Center">
                                <Image Source="{x:Bind Icon, Mode=OneWay}"
                                       Stretch="UniformToFill"
                                       Visibility="{x:Bind Icon, Converter={StaticResource ObjectToVisibility}, Mode=OneWay}" />
                                <Border Background="{x:Bind MonogramBrush}" CornerRadius="8"
                                        Visibility="{x:Bind Icon, Converter={StaticResource NullToVisibility}, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind Monogram}" FontSize="16" FontWeight="SemiBold"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{x:Bind Description, Mode=OneWay}" FontSize="12" Opacity="0.7"
                                           TextTrimming="CharacterEllipsis" MaxLines="1"
                                           Visibility="{x:Bind HasDescription, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- Dedicated Column 1: Versions (Aligned in 130px column like all pages) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Border Background="{StaticResource NeutralSubtleBrush}"
                                BorderBrush="{StaticResource NeutralPillBorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Version, Mode=OneWay}" FontSize="11" Opacity="0.8" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                    Visibility="{x:Bind UpdateAvailable, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                            <TextBlock Text="→" FontSize="11" Opacity="0.5" VerticalAlignment="Center"/>
                            <Border Background="{StaticResource AccentSubtleBrush}"
                                    BorderBrush="{StaticResource AccentPillBorderBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind LatestTag, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Dedicated Column 2: Actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Command="{x:Bind UpdateOneCommand}" CommandParameter="{x:Bind}"
                                AutomationProperties.Name="{x:Bind BtnUpdateOne, Mode=OneWay}"
                                Visibility="{x:Bind UpdateAvailable, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="12,6" FontSize="12">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE896;" FontSize="12"/>
                                <TextBlock Text="{x:Bind BtnUpdateOne}" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind LaunchAppCommand}" CommandParameter="{x:Bind}"
                                AutomationProperties.Name="{x:Bind BtnLaunch, Mode=OneWay}"
                                Visibility="{x:Bind CanLaunchPrimary, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                                Padding="12,6" CornerRadius="8" FontSize="12"
                                Background="{StaticResource CardBackgroundBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE768;" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="{x:Bind BtnLaunch}" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <Button Padding="8,6" CornerRadius="8"
                                AutomationProperties.Name="{x:Bind MenuEdit, Mode=OneWay}"
                                Background="{StaticResource CardBackgroundBrush}" BorderThickness="1"
                                ToolTipService.ToolTip="{x:Bind MenuEdit, Mode=OneWay}">
                            <FontIcon Glyph="&#xE10C;" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Command="{x:Bind CheckUpdateCommand}" CommandParameter="{x:Bind}"
                                                    Text="Проверить обновление">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE72C;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Command="{x:Bind ShowDetailsCommand}" CommandParameter="{x:Bind}"
                                                    Text="О программе / релизы">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE946;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Command="{x:Bind SkipVersionCommand}" CommandParameter="{x:Bind}"
                                                    Text="{x:Bind MenuSkipVersion, Mode=OneWay}"
                                                    Visibility="{x:Bind UpdateAvailable, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE7E3;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Command="{x:Bind PinCurrentCommand}" CommandParameter="{x:Bind}"
                                                    Text="{x:Bind MenuPinCurrent, Mode=OneWay}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE840;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="32,24" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
            <StackPanel Spacing="4">
                <TextBlock Text="{x:Bind Loc.FilterUpdates, Mode=OneWay}" Style="{StaticResource PageHeaderStyle}" />
                <TextBlock Text="{x:Bind Loc.UpdatesPageSubtitle, Mode=OneWay}" Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16">

                <!-- Toolbar: Next Check Info + Action Buttons -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE823;" FontSize="13" Foreground="{StaticResource TextTertiaryBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.NextCheckText, Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <!-- Check Updates Button -->
                    <Button Grid.Column="1" Command="{x:Bind ViewModel.CheckUpdatesCommand}"
                            AutomationProperties.Name="{x:Bind Loc.QuickCheck, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind Loc.QuickCheck, Mode=OneWay}"
                            Padding="12,6" CornerRadius="8" FontSize="12"
                            Background="{StaticResource CardBackgroundBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ProgressRing IsActive="{x:Bind ViewModel.IsCheckingApps, Mode=OneWay}"
                                          Width="12" Height="12"
                                          Visibility="{x:Bind ViewModel.IsCheckingApps, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                            <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="{StaticResource AccentBrush}"
                                      Visibility="{x:Bind ViewModel.IsCheckingApps, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}"/>
                            <TextBlock Text="{x:Bind Loc.QuickCheck, Mode=OneWay}" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <!-- Update All Button -->
                    <Button Grid.Column="2" Command="{x:Bind ViewModel.UpdateAllCommand}"
                            AutomationProperties.Name="{x:Bind Loc.UpdateAll, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind Loc.UpdateAll, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}"
                            Padding="14,6" CornerRadius="8" FontSize="12">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE896;" FontSize="12"/>
                            <TextBlock Text="{x:Bind Loc.UpdateAll, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Updates List -->
                <ListView ItemsSource="{x:Bind ViewModel.UpdatesGroup, Mode=OneWay}"
                          ItemTemplate="{StaticResource UpdatesPageAppCardTemplate}"
                          SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <!-- Empty state when no updates are available -->
                <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="12" Padding="40,32"
                        BorderThickness="1" BorderBrush="{StaticResource BorderDefaultBrush}"
                        Visibility="{x:Bind ViewModel.UpdatesGroup.Count, Converter={StaticResource InverseCountToVisibility}, Mode=OneWay}">
                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE73E;" FontSize="36" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{x:Bind Loc.NoUpdatesAvailable, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{x:Bind Loc.NoUpdatesSubtitle, Mode=OneWay}" FontSize="12" Opacity="0.7" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
