<Page
    x:Class="AppWatch.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AppWatch.ViewModels"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Grid Padding="32,24" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header + Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,16" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title & Subtitle -->
            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock Text="{x:Bind Loc.HistoryPageTitle, Mode=OneWay}" FontSize="28" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{x:Bind Loc.HistoryPageSubtitle, Mode=OneWay}" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>

            <!-- Toolbar: Search Box, Filter ComboBox, Clear History Button -->
            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         PlaceholderText="{x:Bind Loc.HistorySearchPlaceholder, Mode=OneWay}"
                         Text="{x:Bind SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="13"/>

                <ComboBox Grid.Column="1" MinWidth="130"
                          SelectedIndex="{x:Bind SelectedFilterIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="{x:Bind Loc.HistoryFilterAll, Mode=OneWay}"/>
                    <ComboBoxItem Content="{x:Bind Loc.HistoryFilterSuccess, Mode=OneWay}"/>
                    <ComboBoxItem Content="{x:Bind Loc.HistoryFilterErrors, Mode=OneWay}"/>
                </ComboBox>

                <Button Grid.Column="2" Padding="12,6" CornerRadius="6"
                        Background="{StaticResource HeroOverlayBrush}" BorderThickness="0" FontSize="12"
                        IsEnabled="{x:Bind HasEntries, Mode=OneWay}"
                        Click="ClearHistory_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                        <TextBlock Text="{x:Bind Loc.HistoryClear, Mode=OneWay}"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16">

                <!-- Section header -->
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0">
                    <FontIcon Glyph="&#xE81C;" FontSize="14" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="{x:Bind Loc.HistorySection, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" CharacterSpacing="40"/>
                </StackPanel>

                <!-- History list -->
                <ListView ItemsSource="{x:Bind FilteredEntries}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:HistoryItem">
                            <Grid Padding="16" ColumnSpacing="16" Margin="0,0,0,8"
                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                  BorderThickness="1" CornerRadius="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Monogram -->
                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="6"
                                        Background="{x:Bind MonogramBrush}" VerticalAlignment="Center"
                                        Margin="0,0,12,0">
                                    <TextBlock Text="{x:Bind Monogram}" FontSize="16" FontWeight="SemiBold"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- App + versions + detail -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="{x:Bind AppName}" FontWeight="SemiBold" FontSize="14"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind VersionText}" Opacity="0.7" FontSize="12"/>
                                        <TextBlock Text="{x:Bind Detail}" Opacity="0.5" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Result -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Ellipse Width="10" Height="10" Fill="{x:Bind StatusBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{x:Bind ResultText}" FontSize="12" Opacity="0.8"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Date -->
                                <TextBlock Grid.Column="3" Text="{x:Bind DateText}" Opacity="0.5" FontSize="12"
                                           VerticalAlignment="Center"/>

                                <!-- What's new button with Flyout -->
                                <Button Grid.Column="4" Padding="8,4" CornerRadius="6"
                                        Background="{StaticResource CardBackgroundBrush}" BorderThickness="1"
                                        Visibility="{x:Bind HasReleaseNotes, Mode=OneTime, Converter={StaticResource BoolToVisibility}}"
                                        ToolTipService.ToolTip="{x:Bind DetailsNotesText, Mode=OneTime}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE70F;" FontSize="11" Foreground="{StaticResource AccentBrush}"/>
                                        <TextBlock Text="{x:Bind DetailsNotesText, Mode=OneTime}" FontSize="11"/>
                                    </StackPanel>
                                    <Button.Flyout>
                                        <Flyout>
                                            <ScrollViewer MaxWidth="450" MaxHeight="300" HorizontalScrollBarVisibility="Disabled">
                                                <TextBlock Text="{x:Bind ReleaseNotesText, Mode=OneTime}" TextWrapping="Wrap" FontSize="12" />
                                            </ScrollViewer>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty state -->
                <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="8" Padding="24"
                        Visibility="{x:Bind EmptyStateVisible, Mode=OneWay}">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE81C;" FontSize="24" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{x:Bind EmptyStateMessage, Mode=OneWay}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
