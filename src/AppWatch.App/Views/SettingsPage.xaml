<Page
    x:Class="AppWatch.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    NavigationCacheMode="Required">

    <Grid Padding="32,24" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header (navigation lives in the MainWindow NavigationView pane) -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
            <StackPanel Spacing="4">
                <TextBlock Text="{x:Bind Loc.SettingsPageTitle, Mode=OneWay}" FontSize="28" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{x:Bind Loc.SettingsPageSubtitle, Mode=OneWay}" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="20" Padding="0,0,16,0">

                <!-- General section (ZuiV2: icon + CharacterSpacing label) -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0">
                        <FontIcon Glyph="&#xE713;" FontSize="14" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="{x:Bind Loc.SettingsGeneral, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" CharacterSpacing="40"/>
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <!-- Language -->
                        <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Loc.SettingsLanguage, Mode=OneWay}" FontSize="14"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" MinWidth="160" VerticalAlignment="Center"
                                          SelectedIndex="{x:Bind ViewModel.SelectedLanguageIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="Русский"/>
                                    <ComboBoxItem Content="English"/>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Theme -->
                        <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Loc.SettingsTheme, Mode=OneWay}" FontSize="14"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" MinWidth="160" VerticalAlignment="Center"
                                          SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="{x:Bind Loc.SettingsThemeSystem, Mode=OneWay}"/>
                                    <ComboBoxItem Content="{x:Bind Loc.SettingsThemeDark, Mode=OneWay}"/>
                                    <ComboBoxItem Content="{x:Bind Loc.SettingsThemeLight, Mode=OneWay}"/>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Portable Apps Directory -->
                        <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid ColumnSpacing="16" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Column="0" Grid.Row="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Loc.SettingsPortableRoot, Mode=OneWay}" FontSize="14"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{x:Bind Loc.SettingsPortableRootHint, Mode=OneWay}" FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Grid.Row="0" VerticalAlignment="Center" Padding="12,6" CornerRadius="6"
                                        Background="{StaticResource HeroOverlayBrush}" BorderThickness="0"
                                        Command="{x:Bind ViewModel.BrowsePortableDirectoryCommand}"
                                        Content="{x:Bind Loc.Browse, Mode=OneWay}"/>
                                <Button Grid.Column="2" Grid.Row="0" VerticalAlignment="Center" Padding="12,6" CornerRadius="6"
                                        Background="{StaticResource HeroOverlayBrush}" BorderThickness="0"
                                        Command="{x:Bind ViewModel.ResetPortableDirectoryCommand}"
                                        Content="{x:Bind Loc.Reset, Mode=OneWay}"/>
                                <TextBox Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1"
                                         Text="{x:Bind ViewModel.PortableAppsDirectory, Mode=TwoWay}"
                                         PlaceholderText="%LOCALAPPDATA%\AppWatch\Apps"
                                         FontSize="12"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Behavior section -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0">
                        <FontIcon Glyph="&#xE77B;" FontSize="14" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="{x:Bind Loc.SettingsBehavior, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" CharacterSpacing="40"/>
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <!-- Auto-check -->
                        <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Loc.SettingsAutoCheck, Mode=OneWay}" FontSize="14"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{x:Bind Loc.SettingsAutoCheckHint, Mode=OneWay}" FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                              IsOn="{x:Bind ViewModel.AutoCheckEnabled, Mode=TwoWay}"/>
                            </Grid>
                        </Border>

                        <!-- Auto-refresh icons -->
                        <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Loc.SettingsAutoRefreshIcons, Mode=OneWay}" FontSize="14"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{x:Bind Loc.SettingsAutoRefreshIconsHint, Mode=OneWay}" FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" VerticalAlignment="Center"
                                        Command="{x:Bind ViewModel.RefreshAllIconsCommand}"
                                        IsEnabled="{x:Bind ViewModel.IsRefreshingIcons, Converter={StaticResource InverseBool}, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                                        <TextBlock Text="{x:Bind Loc.SettingsRefreshIconsNow, Mode=OneWay}"/>
                                        <ProgressRing IsActive="{x:Bind ViewModel.IsRefreshingIcons, Mode=OneWay}" Width="14" Height="14"/>
                                    </StackPanel>
                                </Button>
                                <ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                              IsOn="{x:Bind ViewModel.AutoRefreshIconsEnabled, Mode=TwoWay}"/>
                            </Grid>
                        </Border>

                        <!-- Toast notifications -->
                        <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Loc.SettingsToastToggle, Mode=OneWay}" FontSize="14"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{x:Bind Loc.SettingsToastHint, Mode=OneWay}" FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" VerticalAlignment="Center" Padding="12,6" CornerRadius="6"
                                        Background="{StaticResource HeroOverlayBrush}" BorderThickness="0" FontSize="12"
                                        Command="{x:Bind ViewModel.TestNotificationCommand}"
                                        Content="{x:Bind Loc.TestNotification, Mode=OneWay}"/>
                                <ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                              IsOn="{x:Bind ViewModel.ToastNotificationsEnabled, Mode=TwoWay}"/>
                            </Grid>
                        </Border>

                        <!-- WinUI 3 Sound effects -->
                        <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Loc.SettingsSoundEffects, Mode=OneWay}" FontSize="14"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{x:Bind Loc.SettingsSoundEffectsDesc, Mode=OneWay}" FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" VerticalAlignment="Center" Padding="12,6" CornerRadius="6"
                                        Background="{StaticResource HeroOverlayBrush}" BorderThickness="0" FontSize="12"
                                        Command="{x:Bind ViewModel.TestSoundCommand}"
                                        Content="{x:Bind Loc.SettingsTestSound, Mode=OneWay}"/>
                                <ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                              IsOn="{x:Bind ViewModel.SoundEffectsEnabled, Mode=TwoWay}"/>
                            </Grid>
                        </Border>

                        <!-- Interval -->
                                                <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                                    <Grid ColumnSpacing="16">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind Loc.SettingsInterval, Mode=OneWay}" FontSize="14"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                                        </StackPanel>
                                                        <ComboBox Grid.Column="1" MinWidth="120" VerticalAlignment="Center"
                                                                  SelectedIndex="{x:Bind ViewModel.SelectedIntervalIndex, Mode=TwoWay}">
                                                            <ComboBoxItem Content="1 ч"/>
                                                            <ComboBoxItem Content="3 ч"/>
                                                            <ComboBoxItem Content="6 ч"/>
                                                            <ComboBoxItem Content="12 ч"/>
                                                            <ComboBoxItem Content="24 ч"/>
                                                        </ComboBox>
                                                    </Grid>
                                                </Border>

                                                <!-- Update Strategy (per-app default) -->
                                                <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                                    <Grid ColumnSpacing="16">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind Loc.SettingsUpdateStrategy, Mode=OneWay}" FontSize="14"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                                            <TextBlock Text="{x:Bind Loc.SettingsUpdateStrategyHint, Mode=OneWay}" FontSize="11"
                                                                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <ComboBox Grid.Column="1" MinWidth="180" VerticalAlignment="Center"
                                                                  SelectedIndex="{x:Bind ViewModel.SelectedUpdateStrategyIndex, Mode=TwoWay}">
                                                            <ComboBoxItem Content="{x:Bind Loc.SettingsUpdateStrategyAuto, Mode=OneWay}"/>
                                                            <ComboBoxItem Content="{x:Bind Loc.SettingsUpdateStrategyBuiltIn, Mode=OneWay}"/>
                                                            <ComboBoxItem Content="{x:Bind Loc.SettingsUpdateStrategySilent, Mode=OneWay}"/>
                                                            <ComboBoxItem Content="{x:Bind Loc.SettingsUpdateStrategyPortable, Mode=OneWay}"/>
                                                            <ComboBoxItem Content="{x:Bind Loc.SettingsUpdateStrategyExternal, Mode=OneWay}"/>
                                                        </ComboBox>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                <!-- GitHub section -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0">
                        <FontIcon Glyph="&#xE895;" FontSize="14" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="{x:Bind Loc.SettingsGitHub, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" CharacterSpacing="40"/>
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <!-- PAT -->
                        <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Loc.SettingsPatToken, Mode=OneWay}" FontSize="14"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{x:Bind ViewModel.PatStatus, Mode=OneWay}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                                <PasswordBox PlaceholderText="ghp_…" MaxLength="255"
                                             Password="{x:Bind ViewModel.PatToken, Mode=TwoWay}"/>
                            </StackPanel>
                        </Border>

                        <!-- Self-update -->
                                                <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                                    <Grid ColumnSpacing="16">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind Loc.SettingsSelfUpdate, Mode=OneWay}" FontSize="14"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                                            <TextBlock Text="{x:Bind Loc.SettingsSelfUpdateHint, Mode=OneWay}" FontSize="11"
                                                                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" VerticalAlignment="Center" Padding="12,6" CornerRadius="6"
                                                                Background="{StaticResource HeroOverlayBrush}" BorderThickness="0"
                                                                Command="{x:Bind ViewModel.CheckSelfUpdateCommand}"
                                                                Content="{x:Bind Loc.SettingsSelfUpdateCheck, Mode=OneWay}"/>
                                                        <Button Grid.Column="2" VerticalAlignment="Center" Padding="12,6" CornerRadius="6"
                                                                Style="{StaticResource AccentButtonStyle}"
                                                                Command="{x:Bind ViewModel.ApplySelfUpdateCommand}"
                                                                Content="{x:Bind Loc.SettingsSelfUpdateApply, Mode=OneWay}"
                                                                Visibility="{x:Bind ViewModel.CanApplySelfUpdate, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"/>
                                                    </Grid>
                                                </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Background monitors schedule (C12: next-run times from config) -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0">
                        <FontIcon Glyph="&#xE823;" FontSize="14" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="{x:Bind Loc.SettingsScheduleSection, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" CharacterSpacing="40"/>
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <!-- Next apps check -->
                        <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Loc.SettingsNextBackgroundCheck, Mode=OneWay}" FontSize="14"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.NextBackgroundCheckText, Mode=OneWay}"
                                           FontSize="13" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Grid>
                        </Border>

                        <!-- Next catalog check -->
                        <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Loc.SettingsNextCatalogCheck, Mode=OneWay}" FontSize="14"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.NextCatalogCheckText, Mode=OneWay}"
                                           FontSize="13" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Storage & Cache Section -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0">
                        <FontIcon Glyph="&#xE7F4;" FontSize="14" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="{x:Bind Loc.SettingsStorage, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" CharacterSpacing="40"/>
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <!-- Version rollback cache depth & size -->
                        <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Loc.SettingsVersionCache, Mode=OneWay}" FontSize="14"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{x:Bind Loc.SettingsVersionCacheHint, Mode=OneWay}" FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" MinWidth="110" VerticalAlignment="Center"
                                          SelectedIndex="{x:Bind ViewModel.SelectedVersionKeepIndex, Mode=TwoWay}"
                                          Header="{x:Bind Loc.SettingsVersionKeepCount, Mode=OneWay}">
                                    <ComboBoxItem Content="1"/>
                                    <ComboBoxItem Content="3"/>
                                    <ComboBoxItem Content="5"/>
                                    <ComboBoxItem Content="10"/>
                                </ComboBox>
                                <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.VersionCacheSizeText, Mode=OneWay}"
                                           FontSize="13" VerticalAlignment="Center" Margin="8,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Button Grid.Column="3" VerticalAlignment="Center" Padding="12,6" CornerRadius="6"
                                        Background="{StaticResource HeroOverlayBrush}" BorderThickness="0" FontSize="12"
                                        Command="{x:Bind ViewModel.CleanVersionCacheCommand}"
                                        Content="{x:Bind Loc.SettingsClean, Mode=OneWay}"/>
                            </Grid>
                        </Border>

                        <!-- Temp download files -->
                        <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Loc.SettingsTempFiles, Mode=OneWay}" FontSize="14"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{x:Bind Loc.SettingsTempFilesHint, Mode=OneWay}" FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TempFilesSizeText, Mode=OneWay}"
                                           FontSize="13" VerticalAlignment="Center" Margin="8,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Button Grid.Column="2" VerticalAlignment="Center" Padding="12,6" CornerRadius="6"
                                        Background="{StaticResource HeroOverlayBrush}" BorderThickness="0" FontSize="12"
                                        Command="{x:Bind ViewModel.CleanTempFilesCommand}"
                                        Content="{x:Bind Loc.SettingsClean, Mode=OneWay}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Export & import (A3 & Full Backup) -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0">
                        <FontIcon Glyph="&#xE8B5;" FontSize="14" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="{x:Bind Loc.SettingsExportImport, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" CharacterSpacing="40"/>
                    </StackPanel>

                    <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="10" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Command="{x:Bind ViewModel.ExportAppsCommand}"
                                        Content="{x:Bind Loc.ExportApps, Mode=OneWay}"
                                        Padding="12,6" CornerRadius="6"
                                        Background="{StaticResource HeroOverlayBrush}" BorderThickness="0" FontSize="12"/>
                                <Button Command="{x:Bind ViewModel.ImportAppsCommand}"
                                        Content="{x:Bind Loc.ImportApps, Mode=OneWay}"
                                        Padding="12,6" CornerRadius="6"
                                        Background="{StaticResource HeroOverlayBrush}" BorderThickness="0" FontSize="12"/>
                                <Button Command="{x:Bind ViewModel.CopyAppsListCommand}"
                                        Content="{x:Bind Loc.CopyAppsList, Mode=OneWay}"
                                        Padding="12,6" CornerRadius="6"
                                        Background="{StaticResource HeroOverlayBrush}" BorderThickness="0" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Command="{x:Bind ViewModel.ExportFullBackupCommand}"
                                        Content="{x:Bind Loc.ExportFullBackup, Mode=OneWay}"
                                        Padding="12,6" CornerRadius="6"
                                        Background="{StaticResource HeroOverlayBrush}" BorderThickness="0" FontSize="12"/>
                                <Button Command="{x:Bind ViewModel.RestoreFullBackupCommand}"
                                        Content="{x:Bind Loc.RestoreFullBackup, Mode=OneWay}"
                                        Padding="12,6" CornerRadius="6"
                                        Background="{StaticResource HeroOverlayBrush}" BorderThickness="0" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Status + Save -->
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="4,8,0,0">
                    <Button Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.SaveCommand}"
                            Content="{x:Bind Loc.SettingsSave, Mode=OneWay}"
                            Padding="20,8" CornerRadius="6" FontSize="13"/>
                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.8"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
